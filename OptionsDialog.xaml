<Window x:Class="RadioPlayer.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Icon="Assets/app.ico"
        FontFamily="Segoe UI" Background="#FF161B24">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC9D2DE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8C97A6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF232A36"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3A4456"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <!-- One section for now. Future settings: add another labelled field below this block. -->
    <StackPanel Margin="20,16,20,20">
        <TextBlock Style="{StaticResource SectionHeader}" Text="AI-assisted search"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                   Text="Powers natural-language station search. Leave blank to disable AI search (the player works fully without it)."/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Anthropic API key"/>
        <TextBox x:Name="ApiKeyBox"/>

        <TextBlock x:Name="EnvHintText" Style="{StaticResource Hint}" Visibility="Collapsed"/>

        <TextBlock Style="{StaticResource Hint}"
                   Text="Stored encrypted on this PC for your Windows account (DPAPI) — never in plain text and never committed. If left blank, the ANTHROPIC_API_KEY environment variable is used instead. Get a key at console.anthropic.com."/>
        <TextBlock Style="{StaticResource Hint}" Foreground="#FFB9A36A"
                   Text="Changes take effect after restarting the app."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="Save" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
