<Window x:Class="RadioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadioPlayer"
        xmlns:vm="clr-namespace:RadioPlayer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Aurora Radio" Height="580" Width="920"
        Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" Background="#FF06070A">

    <Window.Resources>
        <!-- Segoe Fluent Icons ships with Windows 11; no asset to bundle. -->
        <FontFamily x:Key="FluentIcons">Segoe Fluent Icons</FontFamily>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Small copy button next to the NOW PLAYING label. A persistent dark chip keeps
             it legible over any part of the background art; teal on hover. -->
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#59000000"/>
            <Setter Property="Foreground" Value="#FFDDE3EA"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF5A9B94"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF4A857F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom caption buttons (we removed the native title bar). -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Monochrome glyphs for the taskbar thumbnail buttons (these need an
             ImageSource, not a font glyph). -->
        <DrawingImage x:Key="PlayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF565656" Geometry="M0,0 L0,12 L10,6 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="StopIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF565656" Geometry="M0,0 H11 V11 H0 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Round icon button used for the transport controls. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF2F2F2"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent play/pause button: larger, and swaps glyph with playback state. -->
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="#FF5A9B94"/> <!-- teal, matches background art -->
            <Setter Property="Content" Value="&#xE768;"/> <!-- Play -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;"/> <!-- Pause -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact icon button for the station-management toolbar. -->
        <Style x:Key="ListToolButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Station list rows: connectivity glyph + name + optional description sub-line
             (same layout as the search results so both lists look identical). -->
        <Style x:Key="StationList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <!-- Rows fill the panel width; no sideways scrolling for long names. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- DockPanel bounds the text column so name/description can ellipsize. -->
                        <DockPanel LastChildFill="True" Margin="2,3">
                            <!-- One tooltip for the whole row (hover anywhere): full name +
                                 full description. Description line hides when there is none. -->
                            <DockPanel.ToolTip>
                                <ToolTip MaxWidth="340">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" Foreground="#FFC9D2DE">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </DockPanel.ToolTip>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE704;"
                                       FontFamily="{StaticResource FluentIcons}"
                                       FontSize="14" Opacity="0.85" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}" FontSize="11"
                                           Foreground="#FF93A2B8" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented "tab" pill (RadioButton so exactly one is always selected). -->
        <Style x:Key="SegmentTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFB9C2CF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF5A9B94"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small "add to stations" pill shown on each search result row. -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF5A9B94"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF4A857F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search results: same look as StationList, plus a one-line reason and an Add button. -->
        <Style x:Key="SearchList" TargetType="ListBox" BasedOn="{StaticResource StationList}">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Margin="2,3">
                            <!-- One tooltip for the whole row (hover anywhere): name + reason. -->
                            <DockPanel.ToolTip>
                                <ToolTip MaxWidth="340">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Station.Name}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" Foreground="#FFC9D2DE">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Reason}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </DockPanel.ToolTip>
                            <!-- Add to the fixed station list (does not play). Turns into a
                                 disabled check mark once the station is in the library. -->
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Command="{Binding DataContext.AddSearchResultCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AddButton}">
                                        <Setter Property="Content" Value="&#xE710;"/>
                                        <Setter Property="ToolTip" Value="Add to Stations"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                <Setter Property="Content" Value="&#xE73E;"/>
                                                <Setter Property="ToolTip" Value="In your stations"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Foreground" Value="#FF5A9B94"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE704;"
                                       FontFamily="{StaticResource FluentIcons}" FontSize="14"
                                       Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Station.Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#FF93A2B8"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Reason}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Taskbar thumbnail buttons (shown in the live preview when hovering the icon). -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfoCollection>
                    <ThumbButtonInfo Command="{Binding PlayPauseCommand}"
                                     Description="{Binding PlayPauseLabel}"
                                     ImageSource="{StaticResource PlayIcon}"/>
                    <ThumbButtonInfo Command="{Binding StopCommand}"
                                     Description="Stop"
                                     ImageSource="{StaticResource StopIcon}"/>
                </ThumbButtonInfoCollection>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <!-- Drag the window from anywhere; interactive controls handle their own clicks
         first, so this only fires on empty/background areas. -->
    <Grid MouseLeftButtonDown="Window_DragMove">
        <!-- ===== Background graphic layer =====
             Gradient is the fallback shown if the image fails to load. -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B2A40" Offset="0"/>
                <GradientStop Color="#FF0E1320" Offset="0.55"/>
                <GradientStop Color="#FF06070A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Image Source="Assets/player-bg.png" Stretch="UniformToFill"/>

        <!-- Scrim so light text stays legible over any background. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#B3000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== Content ===== -->
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stations / Search tabbed panel -->
            <Border Grid.Column="0" Margin="0,0,16,0" Padding="12"
                    Background="#33000000" CornerRadius="10">
                <DockPanel>
                    <!-- Segmented tab switch -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="StationsTab" GroupName="leftTab" IsChecked="True"
                                     Style="{StaticResource SegmentTab}" Content="Stations"/>
                        <RadioButton x:Name="SearchTab" GroupName="leftTab" Margin="6,0,0,0"
                                     Style="{StaticResource SegmentTab}" Content="Search"/>
                    </StackPanel>

                    <Grid>
                        <!-- ===== Stations tab ===== -->
                        <DockPanel Visibility="{Binding IsChecked, ElementName=StationsTab,
                                   Converter={StaticResource BoolToVis}}">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource ListToolButton}" Content="&#xE710;"
                                        Command="{Binding AddStationCommand}" ToolTip="Add station"/>
                                <Button Style="{StaticResource ListToolButton}" Content="&#xE70F;"
                                        Command="{Binding EditStationCommand}" ToolTip="Edit station"/>
                                <Button Style="{StaticResource ListToolButton}" Content="&#xE74D;"
                                        Command="{Binding DeleteStationCommand}" ToolTip="Delete station"/>
                            </StackPanel>
                            <ListBox Style="{StaticResource StationList}"
                                     ItemsSource="{Binding Stations}"
                                     SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                     MouseDoubleClick="Stations_DoubleClick"/>
                        </DockPanel>

                        <!-- ===== Search tab ===== -->
                        <DockPanel Visibility="{Binding IsChecked, ElementName=SearchTab,
                                   Converter={StaticResource BoolToVis}}">
                            <!-- Prompt + search -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="PromptBox" FontSize="13" Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         Background="#FF232A36" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF"
                                         BorderBrush="#FF3A4456" BorderThickness="1"
                                         Text="{Binding SearchPrompt, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <!-- Placeholder shown over the empty box; clicks pass through. -->
                                <TextBlock Grid.Column="0" IsHitTestVisible="False"
                                           Text="Describe a vibe, mood, or activity…"
                                           Foreground="#FF6E7A8A" FontSize="13"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PromptBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Style="{StaticResource ListToolButton}"
                                        Content="&#xE721;" ToolTip="Search"
                                        Height="32" Width="34" Margin="6,0,0,0"
                                        Command="{Binding SearchCommand}"/>
                            </Grid>

                            <!-- Status + loading spinner (placeholder; themed animation later) -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"
                                      Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                                    <Grid.RenderTransform>
                                        <RotateTransform/>
                                    </Grid.RenderTransform>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="2"/>
                                    <Path Stroke="#FF5A9B94" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 7,1 A 6,6 0 0 1 13,7"/>
                                </Grid>
                                <TextBlock Text="{Binding SearchStatus}" FontSize="11" Foreground="#FF8C97A6"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <ListBox Style="{StaticResource SearchList}"
                                     ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                     MouseDoubleClick="SearchResults_DoubleClick"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Now playing + transport (extra left margin to breathe from the left panel) -->
            <Grid Grid.Column="1" Margin="24,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <!-- Section label + small copy button -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="NOW PLAYING" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8FA3BF" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource CopyButton}" Click="CopyNowPlaying_Click"
                                Content="&#xE8C8;" ToolTip="Copy title &amp; artist"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasTrackInfo, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="26" FontWeight="SemiBold"
                               Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding NowPlayingArtist}" FontSize="16"
                               Foreground="#FFD2D8E0" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Currently-playing station (source of truth for what's playing). -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding HasStation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE704;" FontFamily="{StaticResource FluentIcons}"
                                   FontSize="13" Foreground="#FF8FA3BF"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding NowPlayingStation}" FontSize="14"
                                   Foreground="#FFB9C2CF" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Status line with a loading spinner while connecting -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <Grid.RenderTransform>
                                <RotateTransform/>
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Ellipse Stroke="#33FFFFFF" StrokeThickness="2"/>
                            <Path Stroke="#FF5A9B94" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 7,1 A 6,6 0 0 1 13,7"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                   Foreground="#FF8C97A6" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Transport controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,16">
                    <Button Style="{StaticResource PlayPauseButton}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="{Binding PlayPauseLabel}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding NextStationCommand}"
                            Content="&#xE893;" ToolTip="Next station"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding StopCommand}"
                            Content="&#xE71A;" ToolTip="Stop"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource FluentIcons}"
                               FontSize="16" Foreground="#FFD2D8E0"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider Width="200" Minimum="0" Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Caption buttons (replace the removed native title bar). -->
