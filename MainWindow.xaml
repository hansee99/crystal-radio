<Window x:Class="RadioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadioPlayer"
        xmlns:vm="clr-namespace:RadioPlayer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Radio Player" Height="460" Width="720"
        Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" Background="#FF06070A">

    <Window.Resources>
        <!-- Segoe Fluent Icons ships with Windows 11; no asset to bundle. -->
        <FontFamily x:Key="FluentIcons">Segoe Fluent Icons</FontFamily>

        <!-- Custom caption buttons (we removed the native title bar). -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Monochrome glyphs for the taskbar thumbnail buttons (these need an
             ImageSource, not a font glyph). -->
        <DrawingImage x:Key="PlayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF565656" Geometry="M0,0 L0,12 L10,6 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="StopIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF565656" Geometry="M0,0 H11 V11 H0 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Round icon button used for the transport controls. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF2F2F2"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent play/pause button: larger, and swaps glyph with playback state. -->
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="#FF5A9B94"/> <!-- teal, matches background art -->
            <Setter Property="Content" Value="&#xE768;"/> <!-- Play -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;"/> <!-- Pause -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact icon button for the station-management toolbar. -->
        <Style x:Key="ListToolButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Station list rows: music-note glyph + name. -->
        <Style x:Key="StationList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <!-- Rows fill the panel width; no sideways scrolling for long names. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- DockPanel bounds the name's width so it can ellipsize. -->
                        <DockPanel LastChildFill="True" Margin="2">
                            <TextBlock DockPanel.Dock="Left" Text="&#xEC4F;"
                                       FontFamily="{StaticResource FluentIcons}"
                                       FontSize="14" Opacity="0.85" Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"/>
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Taskbar thumbnail buttons (shown in the live preview when hovering the icon). -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfoCollection>
                    <ThumbButtonInfo Command="{Binding PlayPauseCommand}"
                                     Description="{Binding PlayPauseLabel}"
                                     ImageSource="{StaticResource PlayIcon}"/>
                    <ThumbButtonInfo Command="{Binding StopCommand}"
                                     Description="Stop"
                                     ImageSource="{StaticResource StopIcon}"/>
                </ThumbButtonInfoCollection>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <!-- Drag the window from anywhere; interactive controls handle their own clicks
         first, so this only fires on empty/background areas. -->
    <Grid MouseLeftButtonDown="Window_DragMove">
        <!-- ===== Background graphic layer =====
             Gradient is the fallback shown if the image fails to load. -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B2A40" Offset="0"/>
                <GradientStop Color="#FF0E1320" Offset="0.55"/>
                <GradientStop Color="#FF06070A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Image Source="Assets/player-bg.png" Stretch="UniformToFill"/>

        <!-- Scrim so light text stays legible over any background. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#B3000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== Content ===== -->
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stations -->
            <Border Grid.Column="0" Margin="0,0,16,0" Padding="12"
                    Background="#33000000" CornerRadius="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="STATIONS" FontWeight="SemiBold"
                               FontSize="11" Foreground="#FFB9C2CF" Margin="2,0,0,8"/>
                    <!-- Manage stations -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource ListToolButton}" Content="&#xE710;"
                                Command="{Binding AddStationCommand}" ToolTip="Add station"/>
                        <Button Style="{StaticResource ListToolButton}" Content="&#xE70F;"
                                Command="{Binding EditStationCommand}" ToolTip="Edit station"/>
                        <Button Style="{StaticResource ListToolButton}" Content="&#xE74D;"
                                Command="{Binding DeleteStationCommand}" ToolTip="Delete station"/>
                    </StackPanel>
                    <ListBox Style="{StaticResource StationList}"
                             ItemsSource="{Binding Stations}"
                             SelectedItem="{Binding SelectedStation, Mode=TwoWay}"/>
                </DockPanel>
            </Border>

            <!-- Now playing + transport -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="NOW PLAYING" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FF8FA3BF" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="26" FontWeight="SemiBold"
                               Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding NowPlayingArtist}" FontSize="16"
                               Foreground="#FFD2D8E0" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="#FF8C97A6" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Transport controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,16">
                    <Button Style="{StaticResource PlayPauseButton}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="{Binding PlayPauseLabel}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding NextStationCommand}"
                            Content="&#xE893;" ToolTip="Next station"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding StopCommand}"
                            Content="&#xE71A;" ToolTip="Stop"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource FluentIcons}"
                               FontSize="16" Foreground="#FFD2D8E0"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider Width="200" Minimum="0" Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Caption buttons (replace the removed native title bar). -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                    Content="&#xE921;" ToolTip="Minimize"/>
            <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                    Content="&#xE8BB;" ToolTip="Close"/>
        </StackPanel>
    </Grid>
</Window>
