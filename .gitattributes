# Files that run on the Raspberry Pi must keep LF endings even when checked out on Windows
# (core.autocrlf=true here): bash reads a trailing \r as part of every command, and systemd
# rejects it in unit files.
deploy/pi/*.sh      text eol=lf
deploy/pi/*.service text eol=lf
scripts/*.sh        text eol=lf
deploy/pi/*.timer   text eol=lf
