<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:RadioPlayer.Controls">

    <!-- ============================================================
         Crystal Radio theme (Direction A). Foundation resources only:
         colours/brushes, the UI font, and the vector icon geometries.
         Control styles are added per redesign phase as they're consumed.
         Values are taken verbatim from XAML-IMPLEMENTATION-SPEC.md.
         ============================================================ -->

    <!-- Shared converter: lives here rather than in MainWindow so this dictionary's own
         templates (staged progress, panel states) can use it; the window picks it up through
         Application.Resources. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Typography: Hanken Grotesk (the design font), bundled from Fonts/static and embedded
         as a Resource, so it renders on any machine without installation. -->
    <FontFamily x:Key="UiFont">/crystal-radio;component/Fonts/static/#Hanken Grotesk</FontFamily>

    <!-- Surfaces -->
    <Color x:Key="BgDeep">#FF050D0C</Color>
    <Color x:Key="BgPanel">#FF06110F</Color>
    <SolidColorBrush x:Key="WindowBg"      Color="#FF050D0C"/>
    <SolidColorBrush x:Key="PanelBg"       Color="#7F040B0A"/>
    <!-- Opaque panel surface — dialogs need a solid backdrop, not the main window's translucent one. -->
    <SolidColorBrush x:Key="BgPanelSolid"  Color="#FF06110F"/>
    <SolidColorBrush x:Key="Hairline"      Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="HairlineSoft"  Color="#0FFFFFFF"/>

    <!-- Fills (white at low alpha) -->
    <SolidColorBrush x:Key="FillSubtle"    Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="FillTrack"     Color="#21FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#FFF3F9F7"/>
    <SolidColorBrush x:Key="TextBody"      Color="#FFE7F0EE"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFBCCCC8"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#FF7D938E"/>
    <!-- Lifted from #5F736F (3.9:1 — failed AA at the 11.5-12px sizes this tier carries) to
         ~7.1:1 per the UX audit. The old value lives on as NonText below, for hairline-ish
         decorative uses only — never for anything readable. -->
    <SolidColorBrush x:Key="TextFaint"     Color="#FF8A9F9A"/>
    <SolidColorBrush x:Key="NonText"       Color="#FF5F736F"/>

    <!-- Teal accent ramp -->
    <Color x:Key="TealColor">#FF56C7BA</Color>
    <SolidColorBrush x:Key="Teal"          Color="#FF56C7BA"/>
    <SolidColorBrush x:Key="TealBright"    Color="#FF62D2C4"/>
    <SolidColorBrush x:Key="TealText"      Color="#FFCDEEE7"/>
    <SolidColorBrush x:Key="TealTint07"    Color="#1256C7BA"/>
    <SolidColorBrush x:Key="TealTint10"    Color="#1A56C7BA"/>
    <SolidColorBrush x:Key="TealTint16"    Color="#2956C7BA"/>
    <SolidColorBrush x:Key="TealBorder22"  Color="#3856C7BA"/>
    <SolidColorBrush x:Key="TealBorder35"  Color="#5956C7BA"/>

    <!-- Primary play button gradient -->
    <LinearGradientBrush x:Key="PlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6FDCCD" Offset="0"/>
        <GradientStop Color="#FF34988D" Offset="1"/>
    </LinearGradientBrush>

    <!-- Volume fill gradient -->
    <LinearGradientBrush x:Key="VolumeFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF34988D" Offset="0"/>
        <GradientStop Color="#FF62D2C4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Brand badge gradient (title bar logo tile) -->
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF62D2C4" Offset="0"/>
        <GradientStop Color="#FF2F8F86" Offset="1"/>
    </LinearGradientBrush>

    <!-- App-wide keyboard-focus ring (UX audit): a teal rounded ring with a small offset,
         replacing WPF's default dotted rectangle. Keyed to the system focus-visual key so
         every control picks it up without per-style wiring. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="9" RadiusY="9"
                               Stroke="{StaticResource Teal}" StrokeThickness="2"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Icon geometries (24x24 box; Stretch=Uniform scales them) ===== -->

    <!-- Stroke icons -->
    <PathGeometry x:Key="RadioGeometry" Figures="M8.6 8.6a5 5 0 0 0 0 6.8 M15.4 8.6a5 5 0 0 1 0 6.8 M6.1 6.1a9 9 0 0 0 0 11.8 M17.9 6.1a9 9 0 0 1 0 11.8"/>
    <PathGeometry x:Key="PlusGeometry" Figures="M12 6.5 L12 17.5 M6.5 12 L17.5 12"/>
    <PathGeometry x:Key="CheckGeometry" Figures="M5 12.5 L10 17.5 L19 7.5"/>
    <PathGeometry x:Key="SearchGeometry" Figures="M11 4.4 A6.6 6.6 0 1 0 11 17.6 A6.6 6.6 0 1 0 11 4.4 M16 16 L20.5 20.5"/>
    <PathGeometry x:Key="CopyGeometry" Figures="M9 9 H18 a2 2 0 0 1 2 2 V20 H11 a2 2 0 0 1 -2 -2 Z M5 15 V6 a2 2 0 0 1 2 -2 H15"/>
    <!-- Sliders: two horizontal tracks, each with a knob (track gapped around the knob). -->
    <PathGeometry x:Key="SettingsGeometry" Figures="M4 8 H6.5 M11.5 8 H20 M6.5 8 A2.5 2.5 0 1 0 11.5 8 A2.5 2.5 0 1 0 6.5 8 M4 16 H12.5 M17.5 16 H20 M12.5 16 A2.5 2.5 0 1 0 17.5 16 A2.5 2.5 0 1 0 12.5 16"/>
    <PathGeometry x:Key="InfoGeometry" Figures="M12 3.6 A8.4 8.4 0 1 0 12 20.4 A8.4 8.4 0 1 0 12 3.6 M12 11 V16"/>
    <PathGeometry x:Key="MinGeometry" Figures="M6 12 H18"/>
    <PathGeometry x:Key="CloseGeometry" Figures="M7 7 L17 17 M17 7 L7 17"/>
    <PathGeometry x:Key="VolumeWaves" Figures="M16 9.2a4 4 0 0 1 0 5.6 M18.4 7a7.2 7.2 0 0 1 0 10"/>
    <!-- Back chevron (stroke) for the About reading-view header. -->
    <PathGeometry x:Key="BackGeometry" Figures="M14 6 L8 12 L14 18"/>

    <!-- Sparkle (fill) — the mark for every AI action: "About this track" pill, the About
         eyebrow, regenerate, and DJ mode's "YOUR DJ" attribution.
         The arms are QUADRATIC, not straight. The previous version joined the four tips with
         straight lines, which at 12-16px rendered as a plus — indistinguishable from the
         save-to-library glyph, so the two most different actions on the screen carried the same
         mark. Concave arms plus the small second star read unmistakably as a sparkle at icon
         size, which is the whole job of this shape. -->
    <PathGeometry x:Key="SparkleGeometry"
                  Figures="M10 2.2 Q11.3 8.7 17.8 10 Q11.3 11.3 10 17.8 Q8.7 11.3 2.2 10 Q8.7 8.7 10 2.2 Z
                           M18.4 14.6 Q19 17.4 21.8 18 Q19 18.6 18.4 21.4 Q17.8 18.6 15 18 Q17.8 17.4 18.4 14.6 Z"/>

    <!-- Fill icons -->
    <PathGeometry x:Key="PlayGeometry" Figures="M8 5 L19 12 L8 19 Z"/>
    <GeometryGroup x:Key="PauseGeometry">
        <RectangleGeometry Rect="8,5.5,3,13" RadiusX="1" RadiusY="1"/>
        <RectangleGeometry Rect="13,5.5,3,13" RadiusX="1" RadiusY="1"/>
    </GeometryGroup>
    <RectangleGeometry x:Key="StopGeometry" Rect="6.5,6.5,11,11" RadiusX="2.6" RadiusY="2.6"/>
    <GeometryGroup x:Key="NextGeometry">
        <PathGeometry Figures="M6.5 5.5 L15 12 L6.5 18.5 Z"/>
        <RectangleGeometry Rect="15.7,5.5,2.4,13" RadiusX="1" RadiusY="1"/>
    </GeometryGroup>
    <GeometryGroup x:Key="PrevGeometry">
        <PathGeometry Figures="M17.5 5.5 L9 12 L17.5 18.5 Z"/>
        <RectangleGeometry Rect="5.9,5.5,2.4,13" RadiusX="1" RadiusY="1"/>
    </GeometryGroup>
    <PathGeometry x:Key="VolumeGeometry" Figures="M4 9.5 L8 9.5 L13 5.5 L13 18.5 L8 14.5 L4 14.5 Z"/>
    <PathGeometry x:Key="HeartGeometry" Figures="M12 20 C5 15.6 5 10.4 5 10.4 A3.7 3.7 0 0 1 12 7.2 A3.7 3.7 0 0 1 19 10.4 C19 15.6 12 20 12 20 Z"/>
    <!-- Eighth note (history rows): head circle + stem + slanted beam -->
    <PathGeometry x:Key="NoteGeometry" Figures="M7 16.8 A2.6 2.6 0 1 0 12.2 16.8 A2.6 2.6 0 1 0 7 16.8 M12.2 16.8 L12.2 5.4 L17.6 7"/>
    <!-- Save (history rows, Now Playing mark-for-save): arrow down into a tray.
         Superseded by the Add/Check circle pair below for save affordances — kept because the
         taskbar thumbnail glyphs still reference this shape. -->
    <!-- Lines of text: the lyrics pill's icon. Explicitly NOT the sparkle — see AboutPillButton. -->
    <PathGeometry x:Key="LyricsGeometry"
                  Figures="M6 8.2 H18 V9.8 H6 Z M6 11.4 H18 V13 H6 Z M6 14.6 H13.5 V16.2 H6 Z"/>

    <PathGeometry x:Key="SaveGeometry" Figures="M12 4.5 L12 14 M8 10.5 L12 14.5 L16 10.5 M5.5 18 L18.5 18"/>

    <!-- Save-to-library, as its own family distinct from the sparkle (UX audit: the sparkle is
         reserved for "AI does something here"). Same circle, three contents: plus = not saved,
         plus + teal = marked, saving when the song ends, check + teal = in your library. -->
    <PathGeometry x:Key="AddCircleGeometry"
                  Figures="M12 3.6 A8.4 8.4 0 1 0 12 20.4 A8.4 8.4 0 1 0 12 3.6 M12 8.2 V15.8 M8.2 12 H15.8"/>
    <PathGeometry x:Key="CheckCircleGeometry"
                  Figures="M12 3.6 A8.4 8.4 0 1 0 12 20.4 A8.4 8.4 0 1 0 12 3.6 M8.1 12.2 L10.9 15.1 L15.9 9.6"/>
    <!-- Edit (pencil) + Delete (trash can) for the per-row station actions -->
    <PathGeometry x:Key="EditGeometry" Figures="M4 20 L4 16 L15 5 L19 9 L8 20 Z M12.5 7.5 L16.5 11.5"/>
    <PathGeometry x:Key="DeleteGeometry" Figures="M5.5 7 H18.5 M9.5 7 V5 H14.5 V7 M7 7 L8 19.5 H16 L17 7 M10.5 10 V16 M13.5 10 V16"/>

    <!-- ===== Title-bar icon buttons (R2). Content = a stroke Geometry.
         32px minimum hit target (UX audit) — the glyph stays 16px; only padding grows. ===== -->
    <Style x:Key="TitleIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="#FF7F9A95"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Opt out of the WindowChrome caption drag region so clicks register. -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Background="Transparent">
                        <!-- 24-unit canvas scaled to 16px (keeps the glyph's padding + thin stroke,
                             instead of Stretch inflating the tight bounding box). -->
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sub-nav underline tabs (Shared Framework Spec, pin 1) =====
         Visually distinct from the segmented PillTab used for the Radio/Library mode toggle:
         a left-aligned label with a thin underline that lights up when selected, rather than a
         filled pill, so the two navigation levels don't look like the same control. -->
    <Style x:Key="UnderlineTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,22,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Padding gives the text-only tab a ~32px click band (UX audit) without
                         changing the label/underline visual. -->
                    <StackPanel Background="Transparent">
                        <ContentPresenter Margin="2,8,2,7" HorizontalAlignment="Left"/>
                        <Border x:Name="underline" Height="2" CornerRadius="1" Background="Transparent"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter TargetName="underline" Property="Background" Value="{StaticResource Teal}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Left panel (R4) ===== -->

    <!-- Segmented pill tab (two share a rounded container). -->
    <Style x:Key="PillTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FF7F948F"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="8" Padding="0,7" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource TealTint16}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#4756C7BA"/>
                            <Setter Property="Foreground" Value="{StaticResource TealText}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="b" Property="Background" Value="#0AFFFFFF"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List row container: rounded hover/selected, teal left bar when selected. -->
    <Style x:Key="StationRowItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="10" Padding="10" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealTint10}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Row typography (UX audit) =====
         Every list row is one of two shapes, and these three styles are what enforce it:
         a shared title, plus a subtitle that is EITHER single-line (compact rows: history,
         library songs, DJ sources) OR capped at two wrapped lines (detailed rows, where a
         description or reason earns the height: stations, search results, curated queue).
         Previously each list hand-rolled its own, which is how the Songs tab ended up mixing
         one-line artist rows with three-line description rows in a single list. -->
    <Style x:Key="RowTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RowSubtitleCompact" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RowSubtitleDetailed" TargetType="TextBlock" BasedOn="{StaticResource RowSubtitleCompact}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxHeight" Value="30"/>   <!-- exactly two lines at 11.5px -->
    </Style>

    <!-- Ghost square (+) button on search rows. Content = a stroke Geometry.
         32px minimum hit target (UX audit) — glyph size unchanged. -->
    <Style x:Key="GhostSquareButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="#FF8FB6AE"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="Transparent"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Path Data="{TemplateBinding Content}" Stretch="Uniform" Width="15" Height="15"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource TealTint16}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Teal}"/>
                            <Setter Property="Foreground" Value="{StaticResource TealBright}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Transport + volume (R5) ===== -->

    <!-- Round ghost transport button (prev/next/stop). Content = a filled Geometry. -->
    <Style x:Key="RoundGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFBCD0CC"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="999" Background="Transparent"
                            BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <Path Data="{TemplateBinding Content}" Stretch="Uniform" Width="20" Height="20"
                              Fill="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary play/pause button: teal gradient + glow. -->
    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF04201C"/>
        <Setter Property="Width" Value="62"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Content" Value="{StaticResource PlayGeometry}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{StaticResource PlayBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF56C7BA" BlurRadius="28"
                                                  ShadowDepth="6" Direction="270" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Path Data="{TemplateBinding Content}" Stretch="Uniform" Width="26" Height="26"
                              Fill="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.94"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Volume slider: gradient-filled track (via the Track's decrease button) + glowing thumb. -->
    <Style x:Key="SeekBarSlider" TargetType="Slider">
        <Setter Property="Height" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="3" Background="{StaticResource FillTrack}"/>
                        <!-- Track must mirror the slider's range/value or the thumb can't move. -->
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="3"
                                                    Background="{StaticResource VolumeFill}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="#FFEAFFFB">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="6"
                                                                      ShadowDepth="2" Opacity="0.45"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Volume slider: deliberately NOT a sibling of the seek bar above it.
         Both used to share one style — same teal fill, same 4px track, same 14px thumb — which
         said the two controls matter equally. Seek is touched constantly; volume is set once a
         session. So this one is neutral grey, thinner (3px) and smaller-thumbed (10px), and teal
         is kept for "this is live": the seek bar and the play button. -->
    <Style x:Key="MutedSlider" TargetType="Slider">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="3" CornerRadius="2" Background="#24FFFFFF"/>
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="2" Background="#FF8A9F9A"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Width="10" Height="10" Opacity="0.8">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="#FFBCCCC8"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Brightens to match the label/readout appearing on hover, so the whole
                             group wakes up together rather than the number alone. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Thumb" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button: red hover + white stroke. -->
    <Style x:Key="TitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleIconButton}">
        <Setter Property="Foreground" Value="#FF9AACA8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Background="Transparent">
                        <!-- 24-unit canvas scaled to 16px (keeps the glyph's padding + thin stroke,
                             instead of Stretch inflating the tight bounding box). -->
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFE81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== "About this track" controls ===== -->

    <!-- Trigger pill: icon + label, teal-tinted. Content is the label; Tag is the icon geometry.
         Defaults to the sparkle, which in this app means AI-GENERATED — GhostPillButton exists
         precisely because DJ "End session" must not carry it. So anything sourced rather than
         generated overrides Tag: lyrics come verbatim from LRCLIB, and a sparkle on that pill would
         claim a model wrote them. -->
    <Style x:Key="AboutPillButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Tag" Value="{StaticResource SparkleGeometry}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="10" Padding="13,9,16,9"
                            Background="#1F56C7BA" BorderBrush="#4D56C7BA" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{TemplateBinding Tag}" Stretch="Uniform"
                                  Width="16" Height="16" Fill="#FF62D2C4" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Content}" Margin="9,0,0,0" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#FFBDEEE6" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3356C7BA"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#8056C7BA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact card action: a small teal pill for an action that lives INSIDE a card header, where
         AboutPillButton is too tall (36px against a 14px eyebrow) and GhostPillButton already reads
         as "End session" in the one card that has both.

         Exists because DJ "Change vibe" started life as an AboutLinkButton — bare text with an icon
         — and nobody could tell it was clickable. A visible fill and border is the whole point; it is
         the smallest thing that still looks like a control. Icon comes from Tag, as AboutPillButton
         does, defaulting to the sparkle. -->
    <Style x:Key="CardPillButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Tag" Value="{StaticResource SparkleGeometry}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Padding="9,4,11,5"
                            Background="{StaticResource TealTint10}"
                            BorderBrush="{StaticResource TealBorder35}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{TemplateBinding Tag}" Stretch="Uniform" Width="12" Height="12"
                                  Fill="#FF62D2C4" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Content}" Margin="6,0,0,0" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TealText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource TealTint16}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Teal}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost pill: a quiet sibling of AboutPillButton for non-AI secondary actions (DJ
         "End session" — UX audit: Stop must not carry the sparkle or match Start's weight).
         Hairline border, muted label, no icon; disabled fades. -->
    <Style x:Key="GhostPillButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="10" Padding="14,9"
                            Background="Transparent" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Back button: 38px circle with a stroke chevron, returns to Now Playing. -->
    <Style x:Key="AboutBackButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="999" Background="Transparent"
                            BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource BackGeometry}" Stroke="#FFBCD0CC"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#38FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Regenerate: borderless sparkle + label link in the reading-view footer. -->
    <Style x:Key="AboutLinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#FF8FB6AE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel x:Name="b" Orientation="Horizontal" Background="Transparent">
                        <Path Data="{StaticResource SparkleGeometry}" Stretch="Uniform"
                              Width="13" Height="13" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        <TextBlock Text="{TemplateBinding Content}" Margin="6,0,0,0" FontSize="12"
                                   FontWeight="Medium" Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFCDEEE7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Animated equalizer (R6): 4 bars with a staggered ScaleY loop =====
         Each bar animates ITSELF (self-targeted storyboard, no Storyboard.TargetName), so there
         is no name-scope lookup to resolve. Name-based targeting inside a ControlTemplate can
         fail with "'b1' cannot be found in the name scope" when the template is realized in some
         hosts (e.g. a freshly-populated, style-driven ListBox row) — which crashes the process. -->
    <Style x:Key="EqualizerBar" TargetType="Rectangle">
        <Setter Property="Width" Value="2.6"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Margin" Value="0,0,2.5,0"/>
        <Setter Property="Fill" Value="{StaticResource Teal}"/>
        <Setter Property="RadiusX" Value="2"/>
        <Setter Property="RadiusY" Value="2"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform/></Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="EqualizerTemplate">
        <StackPanel Orientation="Horizontal" Height="13" VerticalAlignment="Bottom">
            <Rectangle Style="{StaticResource EqualizerBar}">
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    From="0.25" To="1" Duration="0:0:0.45"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>
            <Rectangle Style="{StaticResource EqualizerBar}">
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation BeginTime="0:0:0.14" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    From="0.25" To="1" Duration="0:0:0.45"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>
            <Rectangle Style="{StaticResource EqualizerBar}">
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation BeginTime="0:0:0.28" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    From="0.25" To="1" Duration="0:0:0.45"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>
            <Rectangle Style="{StaticResource EqualizerBar}">
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation BeginTime="0:0:0.40" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    From="0.25" To="1" Duration="0:0:0.45"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>
        </StackPanel>
    </ControlTemplate>

    <!-- ===== Panel states (UX audit) =====
         Shared message templates for StatePanel's Empty / Loading / Error slots, so all seven
         list panels say their piece the same way. Each takes a plain string as its content. -->

    <!-- Reusable 14px spinner arc — the app's one "you are waiting on something" mark. -->
    <ControlTemplate x:Key="SpinnerTemplate">
        <Grid Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform/>
            </Grid.RenderTransform>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Ellipse Stroke="#33FFFFFF" StrokeThickness="2"/>
            <Path Stroke="{StaticResource Teal}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 7,1 A 6,6 0 0 1 13,7"/>
        </Grid>
    </ControlTemplate>

    <!-- Empty: a quiet invitation, centred in the panel. -->
    <DataTemplate x:Key="PanelMessage">
        <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>
    </DataTemplate>

    <!-- ===== Staged progress (UX audit) =====
         For the 30s+ AI waits. Named steps tick off one at a time and stay on screen, so the
         wait visibly accumulates instead of a spinner that could equally mean "hung". Below
         them, skeleton rows stand in for the results so the panel is never just empty, and a
         ghost Cancel gives a way out. Bound to a ViewModels.StagedProgress. -->

    <!-- One checklist row: ○ pending · ◐ running · ✓ done. -->
    <DataTemplate x:Key="ProgressStageRow">
        <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pending: hollow ring -->
            <Ellipse Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left"
                     VerticalAlignment="Center" Stroke="{StaticResource NonText}" StrokeThickness="1.5">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- Active: the app's spinner -->
            <ContentControl Grid.Column="0" Template="{StaticResource SpinnerTemplate}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Done: teal tick -->
            <Path Grid.Column="0" Data="{StaticResource CheckGeometry}" Stretch="Uniform"
                  Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Stroke="{StaticResource Teal}" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>

            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" Margin="9,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- Running step reads brightest; done steps recede but stay legible. -->
                        <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <!-- A placeholder result row: 34px tile + two bars, matching StationRowItem's geometry so
         the real rows land where the skeletons were. -->
    <Style x:Key="SkeletonBar" TargetType="Border">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Three placeholder rows, geometry matching StationRowItem so the real results land
         roughly where the skeletons were. Bar widths vary so it reads as placeholder content
         rather than a repeating pattern. -->
    <ControlTemplate x:Key="SkeletonRows">
        <StackPanel Opacity="0.85">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- One slow shimmer across the whole block: enough to read as
                                 "placeholder, not content" without drawing the eye. -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.85" To="0.35" Duration="0:0:1.1"
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="#12FFFFFF" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="11,3,0,0">
                    <Border Style="{StaticResource SkeletonBar}" Width="132"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="86" Height="8"
                            Margin="0,7,0,0" Background="#0CFFFFFF"/>
                </StackPanel>
            </Grid>
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="#12FFFFFF" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="11,3,0,0">
                    <Border Style="{StaticResource SkeletonBar}" Width="98"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="72" Height="8"
                            Margin="0,7,0,0" Background="#0CFFFFFF"/>
                </StackPanel>
            </Grid>
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="#12FFFFFF" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="11,3,0,0">
                    <Border Style="{StaticResource SkeletonBar}" Width="116"/>
                    <Border Style="{StaticResource SkeletonBar}" Width="90" Height="8"
                            Margin="0,7,0,0" Background="#0CFFFFFF"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ControlTemplate>

    <!-- The loading slot for long operations: checklist, skeleton rows, and a way out. -->
    <DataTemplate x:Key="PanelProgress">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Margin="2,4,2,0">
                <ItemsControl ItemsSource="{Binding Stages}"
                              ItemTemplate="{StaticResource ProgressStageRow}"/>
                <Button Style="{StaticResource AboutLinkButton}" Content="Cancel"
                        Command="{Binding CancelCommand}" HorizontalAlignment="Left"
                        Margin="21,2,0,0"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <ContentControl DockPanel.Dock="Top" Template="{StaticResource SkeletonRows}"
                            Margin="0,16,0,0" Focusable="False"/>
        </DockPanel>
    </DataTemplate>

    <!-- Error: same shape as Empty, warmer tone. Deliberately not red — these are recoverable
         "that didn't work" states, not failures the user caused. -->
    <DataTemplate x:Key="PanelErrorMessage">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0" MaxWidth="270">
            <Path Data="{StaticResource InfoGeometry}" Stretch="Uniform" Width="20" Height="20"
                  Stroke="#FFB9A36A" StrokeThickness="1.5" StrokeStartLineCap="Round"
                  HorizontalAlignment="Center" Margin="0,0,0,9"/>
            <TextBlock Text="{Binding}" FontSize="12.5" Foreground="#FFC7B486"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- StatePanel itself: all four slots present, exactly one visible. -->
    <Style TargetType="{x:Type ctl:StatePanel}">
        <!-- ContentControl defaults these to Left/Top, which would size the hosted ListBox to
             its content instead of filling the panel (and would strand the centred messages in
             the top-left corner). Stretch is what every slot wants. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:StatePanel}">
                    <!-- Explicit TemplateBindings rather than ContentSource="EmptyContent": the
                         ContentSource convention also looks for {name}TemplateSelector and
                         {name}StringFormat, which this control doesn't define. Binding the two
                         properties we do have keeps it unambiguous. -->
                    <Grid>
                        <ContentPresenter x:Name="ContentSlot" Visibility="Collapsed"/>
                        <ContentPresenter x:Name="EmptySlot" Visibility="Collapsed"
                                          Content="{TemplateBinding EmptyContent}"
                                          ContentTemplate="{TemplateBinding EmptyContentTemplate}"/>
                        <ContentPresenter x:Name="LoadingSlot" Visibility="Collapsed"
                                          Content="{TemplateBinding LoadingContent}"
                                          ContentTemplate="{TemplateBinding LoadingContentTemplate}"/>
                        <ContentPresenter x:Name="ErrorSlot" Visibility="Collapsed"
                                          Content="{TemplateBinding ErrorContent}"
                                          ContentTemplate="{TemplateBinding ErrorContentTemplate}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Content">
                            <Setter TargetName="ContentSlot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="State" Value="Empty">
                            <Setter TargetName="EmptySlot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="State" Value="Loading">
                            <Setter TargetName="LoadingSlot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="ErrorSlot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Modal dialog chrome (UX audit) =====
         Borderless window + the app's own surface, so About/Options/Add-station stop looking
         like a different application. Applied implicitly to anything deriving from AppDialog. -->

    <!-- Primary dialog action: the teal pill from the main window's AI actions, minus the
         sparkle (these aren't AI actions). -->
    <Style x:Key="DialogPrimaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="10" Padding="16,9"
                            Background="#2956C7BA" BorderBrush="#5C56C7BA" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TealText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#4056C7BA"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#9956C7BA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary dialog action: the ghost pill, centred and min-width'd for a button row. -->
    <Style x:Key="DialogGhostButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="10" Padding="16,9"
                            Background="Transparent" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0FFFFFFF"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#38FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog text input: the same radius-10 hairline field as the main window's prompts
         (the Options key box was the only input in the product without it). -->
    <!-- Dialog combo box. Fully templated because WPF's default renders light-on-light inside
         this dark chrome, and its popup ignores the dialog's Foreground entirely. -->
    <Style x:Key="DialogComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                    <Setter Property="Padding" Value="11,7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ib" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ib" Property="Background" Value="{StaticResource TealTint10}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Foreground has to be forwarded explicitly. ToggleButton's own default
                             style sets it, and Control.Foreground IS TextElement.Foreground — so
                             that setter cuts the inheritance chain from the ComboBox, and the
                             selected item renders in the system's near-black on our dark fill. -->
                        <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" CornerRadius="10"
                                            Background="{StaticResource FillSubtle}"
                                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Right" Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="{StaticResource TextMuted}" Margin="0,0,12,0"
                                                  VerticalAlignment="Center"/>
                                            <!-- ContentTemplate is NOT optional here. Without it the
                                                 presenter falls back to ToString() on the selected
                                                 object, so a ComboBox with a DisplayMemberPath shows
                                                 its raw item ("VoiceOption { Value = Warm, ... }")
                                                 in the closed box while the open list looks right. -->
                                            <ContentPresenter Margin="11,8" VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem,
                                                                        RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                        RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Teal}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="#FF10201D" CornerRadius="10" Margin="0,4,0,0"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsPresenter Margin="0,5"/>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource FillSubtle}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Teal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Teal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Options dialog: left-rail sections =====
         A rail item is NOT a PillTab: the pill centres its label in a hugging capsule, while a
         rail item fills the rail's width, left-aligns, and carries a 2px selection bar at its
         leading edge. Templated end to end so no system selection highlight can show through. -->
    <Style x:Key="DialogRailItem" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="fill" CornerRadius="8" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"/>
                        <Border x:Name="bar" Width="2" Height="18" CornerRadius="0,2,2,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="Transparent"/>
                        <ContentPresenter Margin="11,0,10,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fill" Property="Background" Value="{StaticResource FillSubtle}"/>
                        </Trigger>
                        <!-- Selection last so it wins over hover on the item you are pointing at. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fill" Property="Background" Value="{StaticResource TealTint10}"/>
                            <Setter TargetName="fill" Property="BorderBrush" Value="{StaticResource TealBorder35}"/>
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource Teal}"/>
                            <Setter Property="Foreground" Value="{StaticResource TealText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Marks the one setting that cannot apply until the next DJ session. Deliberately neutral
         grey rather than a warning colour: one field wearing it must not imply the rest are
         stale, which is exactly what the old blanket "restart the app" banner did imply. -->
    <Style x:Key="DialogChip" TargetType="Border">
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DialogChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
    </Style>

    <!-- Informational, not a warning: teal tint, no icon beyond a dot. Used for "a key from your
         system is currently in use", which reports a fact rather than asking for anything. -->
    <Style x:Key="DialogNoteBlock" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TealTint07}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TealBorder22}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="10,6,10,7"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="DialogNoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="#FF9FD9CF"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Dialog checkbox. Templated end to end like every other dialog control: WPF's default
         renders a light Win32 box that looks pasted onto this chrome. The tick reuses
         CheckGeometry, stroked rather than filled so it reads at 16px. -->
    <Style x:Key="DialogCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource FillSubtle}"
                                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="tick" Data="{StaticResource CheckGeometry}" Stretch="Uniform"
                                  Width="11" Height="11" Stroke="{StaticResource TealText}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource TealTint16}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource TealBorder35}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Teal}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogSectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="DialogFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,14,0,5"/>
    </Style>

    <Style x:Key="DialogHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- The window itself: transparent frame, rounded surface, hairline border, a drag strip
         with the app's own close button. Implicit, so every AppDialog picks it up. -->
    <Style TargetType="{x:Type ctl:AppDialog}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:AppDialog}">
                    <!-- The margin is shadow room: the window itself is transparent, so the drop
                         shadow needs space inside the window bounds to draw into. SizeToContent
                         accounts for it. -->
                    <Border Background="{StaticResource BgPanelSolid}" CornerRadius="12"
                            BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="14">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF000210" BlurRadius="26" ShadowDepth="5"
                                              Direction="270" Opacity="0.6"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- Title strip doubles as the drag region. Behaviour is attached in
                                 AppDialog.OnApplyTemplate via these part names. -->
                            <Grid x:Name="PART_TitleBar" DockPanel.Dock="Top" Height="44"
                                  Background="Transparent">
                                <TextBlock Text="{TemplateBinding Title}" Margin="20,0,0,0"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Button x:Name="PART_CloseButton"
                                        Style="{StaticResource TitleIconButton}"
                                        Content="{StaticResource CloseGeometry}" ToolTip="Close"
                                        HorizontalAlignment="Right" Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Themed scrollbars (thin, rounded thumb, no arrow buttons) =====
         Implicit (unkeyed) so every ScrollViewer — the lists, the About reader, the dialogs —
         picks it up and matches the app instead of showing native Windows chrome. -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="3" Margin="2" Background="#2EFFFFFF"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#55FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource Teal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- 8px track with a 2px thumb margin on each side gives a ~4px visual thumb (Shared
             Framework Spec pin 8), while the track itself stays a comfortable drag/click target. -->
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb x:Name="thumb" Style="{StaticResource ScrollThumb}" MinHeight="28"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="10"/>
                            <Setter TargetName="thumb" Property="MinHeight" Value="0"/>
                            <Setter TargetName="thumb" Property="MinWidth" Value="28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
