<ctl:AppDialog x:Class="RadioPlayer.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RadioPlayer.Controls"
        Title="Confirm" SizeToContent="WidthAndHeight"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBody}">

    <StackPanel Margin="24,4,24,24" Width="352">
        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource TextSecondary}"/>

        <CheckBox x:Name="SuppressCheck" Style="{StaticResource DialogCheckBox}"
                  Content="Don't ask me again" Margin="0,16,0,0"
                  Visibility="Collapsed"/>

        <!-- Cancel first in the visual order the app already uses (Options, Add station), and it is
             the default: the destructive button should never be the one Enter reaches for. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource DialogGhostButton}"
                    IsDefault="True" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource DialogPrimaryButton}"
                    Margin="10,0,0,0" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</ctl:AppDialog>
