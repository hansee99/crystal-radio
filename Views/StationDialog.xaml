<ctl:AppDialog x:Class="RadioPlayer.StationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RadioPlayer.Controls"
        Title="Add station" Width="440" SizeToContent="Height"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBody}">

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabel}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource DialogTextBox}"/>

        <!-- Closed-combo surface: the same radius-10 hairline field as the text inputs. -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" Data="M 1,1 L 5,5 L 9,1" Stroke="{StaticResource TextMuted}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dropdown rows: the app's list-row treatment rather than a solid teal highlight. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="4,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource TealTint16}"/>
                                <Setter Property="Foreground" Value="{StaticResource TealText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
            <Setter Property="Background" Value="{StaticResource FillSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource BgPanelSolid}"
                                        BorderBrush="#1FFFFFFF" BorderThickness="1"
                                        CornerRadius="10" Margin="0,3,0,0" Padding="0,4"
                                        MinWidth="{Binding ActualWidth,
                                                   RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,0,24,24">
        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox"/>

        <TextBlock Text="Stream URL"/>
        <TextBox x:Name="UrlBox"/>

        <TextBlock Text="Format"/>
        <ComboBox x:Name="FormatBox"/>

        <TextBlock Text="Description (optional)"/>
        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="58" MaxHeight="120" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="ErrorText" Foreground="#FFE0857A" FontSize="12"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
            <Button Content="OK" IsDefault="True" Margin="10,0,0,0"
                    Style="{StaticResource DialogPrimaryButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</ctl:AppDialog>
