<Window x:Class="RadioPlayer.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crystal Radio" Width="380" Height="176"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Self-contained by design: no StaticResource, no merged Theme.xaml. This window is shown
         before the app's resources are loaded, and on the slow machines it exists for, every
         dependency is another thing to load before the first pixel. -->
    <Border CornerRadius="14" Background="#FF0E1513" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="/Assets/app-256.png" Width="40" Height="40" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Crystal Radio" FontSize="19" FontWeight="SemiBold" Foreground="#FFEAF3F1"/>
                    <TextBlock x:Name="VersionText" FontSize="11.5" Margin="0,1,0,0" Foreground="#FF6C807C"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Starting…" FontSize="12.5"
                       Foreground="#FFAFC4C0" TextTrimming="CharacterEllipsis"/>

            <!-- Indeterminate: the steps are known but their durations are not, and they differ by
                 an order of magnitude between a fast machine and the laptop this exists for. A bar
                 that jumps 0-80-100 is a worse lie than an honest sweep. -->
            <Border Grid.Row="2" Height="3" CornerRadius="2" Background="#1AFFFFFF"
                    VerticalAlignment="Bottom" Margin="0,0,0,-12" ClipToBounds="True">
                <Border x:Name="Sweep" Width="110" HorizontalAlignment="Left" CornerRadius="2"
                        Background="#FF56C7BA">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SweepShift" X="-110"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="SweepShift" Storyboard.TargetProperty="X"
                                     From="-110" To="330" Duration="0:0:1.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
