<Window x:Class="RadioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadioPlayer"
        xmlns:vm="clr-namespace:RadioPlayer.ViewModels"
        xmlns:mvvm="clr-namespace:RadioPlayer.Mvvm"
        xmlns:ctl="clr-namespace:RadioPlayer.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Crystal Radio" Height="760" Width="1000"
        MinWidth="760" MinHeight="560"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBody}"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Segoe Fluent Icons ships with Windows 11; no asset to bundle. -->
        <FontFamily x:Key="FluentIcons">Segoe Fluent Icons</FontFamily>

        <!-- BoolToVis now lives in Theme.xaml (its own templates need it); this window's
             references resolve up through Application.Resources to that one. -->
        <mvvm:UrlIsPlayingMultiConverter x:Key="UrlIsPlayingConverter"/>

        <!-- Save (download→check) + About (sparkle) row actions for anything that carries a
             SongHistoryEntry — History rows and "Recently on this station" (Shared Framework
             Spec pin 3: "the download→check pair ... now labeled", reused everywhere it appears).
             AncestorType=Window (not ListBox/ItemsControl) so the same template works regardless
             of which control hosts the row. -->
        <DataTemplate x:Key="SaveAndAboutActions">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Save, as three legible states rather than two-plus-an-absence (UX audit).
                     A song can only be saved if the rolling cache captured its audio while it
                     played; rows that missed that window used to show NOTHING, which reads as a
                     missing button rather than a state. Now the affordance is always there:
                     enabled, dimmed-and-explained, or replaced by the saved mark. -->
                <!-- IsEnabled binds CanSave rather than leaning on the command's CanExecute:
                     RelayCommand only re-evaluates when RaiseCanExecuteChanged is called, and
                     nothing calls it when a segment finishes recording, so the button would go
                     stale. CanSave raises PropertyChanged, so this tracks live. -->
                <Button Margin="0,0,6,0" ToolTipService.ShowOnDisabled="True"
                        IsEnabled="{Binding CanSaveOrMark}"
                        Command="{Binding DataContext.SaveSongCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostSquareButton}">
                            <Setter Property="Content" Value="{StaticResource AddCircleGeometry}"/>
                            <Setter Property="ToolTip" Value="Save to your library"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSegment}" Value="False">
                                    <Setter Property="ToolTip"
                                            Value="Can't save this one — it wasn't recorded while it played"/>
                                </DataTrigger>
                                <!-- The PLAYING row. It has no completed recording yet, so the
                                     "wasn't recorded" message above is untrue for it: the audio is
                                     being captured right now. This is the only save affordance for
                                     the current song since the Now Playing header lost its
                                     duplicate (#37), so it must offer the deferred save rather than
                                     sit disabled with a wrong explanation. Ordered after HasSegment
                                     so it wins. -->
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="ToolTip" Value="Save this song when it finishes"/>
                                </DataTrigger>
                                <!-- Marked while playing: same teal plus the header used to show. -->
                                <DataTrigger Binding="{Binding MarkedForSave}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TealBright}"/>
                                    <Setter Property="ToolTip"
                                            Value="Marked — saves when the song ends; click to cancel"/>
                                </DataTrigger>
                                <!-- Saved: hand over to the teal mark beside it. -->
                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Saved mark. A plain glyph, not a button: it isn't an action, and as a
                     disabled button it would render at the same faded opacity as "can't save",
                     which is the opposite of the confirmation it's meant to be. -->
                <Border Width="32" Height="32" Margin="0,0,6,0" Background="Transparent"
                        ToolTip="In your library"
                        Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource CheckCircleGeometry}" Stretch="Uniform"
                          Width="15" Height="15" Stroke="{StaticResource TealBright}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Style="{StaticResource GhostSquareButton}"
                        Content="{StaticResource SparkleGeometry}"
                        ToolTip="About this song"
                        Command="{Binding DataContext.OpenAboutForEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding DataContext.IsAboutAvailable, RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Monochrome glyphs for the taskbar thumbnail buttons (these need an
             ImageSource, not a font glyph). -->
        <DrawingImage x:Key="PlayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF565656" Geometry="M0,0 L0,12 L10,6 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="StopIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF565656" Geometry="M0,0 H11 V11 H0 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ListToolButton removed with the stranded bottom-left "+" (UX audit b10): the add
             action now lives in the Stations list header and uses the app's GhostSquareButton,
             so there's no separate button family and no Segoe-glyph dependency here. -->

    </Window.Resources>

    <!-- Taskbar thumbnail buttons (shown in the live preview when hovering the icon). -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfoCollection>
                    <ThumbButtonInfo Command="{Binding PlayPauseCommand}"
                                     Description="{Binding PlayPauseLabel}"
                                     ImageSource="{StaticResource PlayIcon}"/>
                    <ThumbButtonInfo Command="{Binding StopCommand}"
                                     Description="Stop"
                                     ImageSource="{StaticResource StopIcon}"/>
                </ThumbButtonInfoCollection>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <!-- Rounded window shell; WindowChrome supplies resize + the 42px caption drag area.
         AllowsTransparency makes the area outside this border transparent (true 13px corners).
         Corners flatten when maximized. UIElement.Clip is set in code-behind (SizeChanged)
         to a matching RectangleGeometry so children are clipped to the rounded shape. -->
    <Border x:Name="ShellBorder" ClipToBounds="True" BorderBrush="#10FFFFFF" BorderThickness="1"
            UseLayoutRounding="True" SnapsToDevicePixels="True"
            Background="{StaticResource WindowBg}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="13"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState,
                                 RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar (Row 0). The bar itself is draggable (caption area). ===== -->
            <Grid Grid.Row="0" Panel.ZIndex="2">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Width="22" Height="22" CornerRadius="6"
                            Background="{StaticResource BrandBrush}">
                        <Path Data="{StaticResource RadioGeometry}" Stretch="Uniform"
                              Width="14" Height="14" Stroke="#FF04201C" StrokeThickness="1.4"/>
                    </Border>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12"
                               FontWeight="SemiBold" Foreground="#FFCFE0DC">
                        <Run Text="CRYSTAL"/><Run Text=" RADIO" Foreground="#FF5C7873" FontWeight="Medium"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleIconButton}" Click="Options_Click"
                            Content="{StaticResource SettingsGeometry}" ToolTip="Options"/>
                    <Button Style="{StaticResource TitleIconButton}" Click="About_Click"
                            Content="{StaticResource InfoGeometry}" ToolTip="About"/>
                    <Button Style="{StaticResource TitleIconButton}" Click="Minimize_Click"
                            Content="{StaticResource MinGeometry}" ToolTip="Minimize"/>
                    <Button Style="{StaticResource TitleCloseButton}" Click="Close_Click"
                            Content="{StaticResource CloseGeometry}" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ===== Body (Row 1): existing background + content (reworked in R3-R5). ===== -->
            <Grid Grid.Row="1">
        <!-- ===== 0. Ambient wave background (spans the whole body, behind everything) =====
             ClipToBounds stops the right-aligned UniformToFill image (which is wider than the
             grid and overflows left) from reaching the 1px shell border and bleeding through
             its semi-transparent stroke at the window's left edge. -->
        <Grid Panel.ZIndex="0" ClipToBounds="True">
            <Rectangle Fill="{StaticResource WindowBg}"/>
            <Image Source="/Assets/player-bg.png" Stretch="UniformToFill" HorizontalAlignment="Right"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TranslateTransform/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="0" To="-10" Duration="0:0:26" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <!-- radial vignette toward the bottom-right glow -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.88,0.78" GradientOrigin="0.88,0.78"
                                         RadiusX="1.3" RadiusY="1.0">
                        <GradientStop Color="#00050D0C" Offset="0.30"/>
                        <GradientStop Color="#80050D0C" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- horizontal scrim: dark on the left (list) fading out to the right. Held darker
                 through the Now Playing content column (UX audit — the recently-played list and
                 status text sit on the artwork's bright diagonal); the artwork keeps its
                 atmosphere only in the top-right where nothing is placed on it. -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF050D0C" Offset="0"/>
                        <GradientStop Color="#DB050D0C" Offset="0.26"/>
                        <GradientStop Color="#C0050D0C" Offset="0.46"/>
                        <GradientStop Color="#8C050D0C" Offset="0.62"/>
                        <GradientStop Color="#38050D0C" Offset="0.78"/>
                        <GradientStop Color="#00050D0C" Offset="0.92"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- top scrim -->
            <Rectangle VerticalAlignment="Top" Height="140">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8C050D0C" Offset="0"/>
                        <GradientStop Color="#00050D0C" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- bottom scrim (UX audit): a solid floor under the transport, seek times and
                 volume, which otherwise cross the brightest part of the artwork. Starts high
                 (280px) and ramps slowly: at 200px it was still light where the transport strip
                 began, so the strip's own tone arrived as a step. The strip now fades in over its
                 top 62px and meets an already-darkening artwork, leaving no visible band. -->
            <Rectangle VerticalAlignment="Bottom" Height="280">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00050D0C" Offset="0"/>
                        <GradientStop Color="#63050D0C" Offset="0.45"/>
                        <GradientStop Color="#E6050D0C" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ===== 1. Foreground columns (list + now playing) ===== -->
        <Grid Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="362"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Stations / Search panel (content restyled in R4) -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,16,14,14">
                    <!-- Mode switch: internet Radio ⟷ local Library player (either/or) -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="11" Padding="3"
                            Background="{StaticResource FillSubtle}"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="playerMode" Style="{StaticResource PillTab}"
                                         Content="Radio" IsChecked="{Binding IsRadioMode, Mode=OneWay}"
                                         Command="{Binding SwitchToRadioCommand}"/>
                            <RadioButton Grid.Column="1" GroupName="playerMode" Style="{StaticResource PillTab}"
                                         Content="Library" IsChecked="{Binding IsLibraryMode, Mode=OneWay}"
                                         Command="{Binding SwitchToLibraryCommand}"/>
                            <RadioButton Grid.Column="2" GroupName="playerMode" Style="{StaticResource PillTab}"
                                         Content="DJ" IsChecked="{Binding IsDjMode, Mode=OneWay}"
                                         Command="{Binding SwitchToDjCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Mode content: the radio, library, and DJ panels share this area -->
                    <Grid>
                    <!-- ================= RADIO panel (Stations / Search / History) ================= -->
                    <DockPanel Visibility="{Binding ShowRadioPanel, Converter={StaticResource BoolToVis}}">
                    <!-- Underlined sub-nav (matches the Library side); the segmented pill is
                         reserved for the Radio/Library mode toggle above, so the two nav levels
                         stay visually distinct. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="StationsTab" GroupName="leftTab" IsChecked="True"
                                     Style="{StaticResource UnderlineTab}" Content="Stations"/>
                        <RadioButton x:Name="SearchTab" GroupName="leftTab"
                                     Style="{StaticResource UnderlineTab}" Content="Search"/>
                        <RadioButton x:Name="HistoryTab" GroupName="leftTab"
                                     Style="{StaticResource UnderlineTab}" Content="History"/>
                    </StackPanel>

                    <Grid>
                        <!-- ===== Stations tab ===== -->
                        <DockPanel Visibility="{Binding IsChecked, ElementName=StationsTab,
                                   Converter={StaticResource BoolToVis}}">
                            <!-- List header with the add action (UX audit b10). It used to be
                                 stranded ~500px below the list it adds to; it belongs on the
                                 list it acts on. -->
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostSquareButton}"
                                        Content="{StaticResource PlusGeometry}" ToolTip="Add a station"
                                        Command="{Binding AddStationCommand}"/>
                                <TextBlock Text="YOUR STATIONS" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#FF6F8C87" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ctl:StatePanel State="{Binding StationsPanelState}"
                                            EmptyContent="No stations yet — add one above, or find some in Search."
                                            EmptyContentTemplate="{StaticResource PanelMessage}">
                            <ListBox ItemsSource="{Binding Stations}"
                                     SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                     MouseDoubleClick="Stations_DoubleClick"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource StationRowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource FillSubtle}"
                                                    BorderBrush="{StaticResource HairlineSoft}" BorderThickness="1">
                                                <Grid>
                                                    <!-- Radio icon (hidden while this station is playing) -->
                                                    <Path Data="{StaticResource RadioGeometry}" Stretch="Uniform"
                                                          Width="17" Height="17" Stroke="#FF6F928C" StrokeThickness="1.4">
                                                        <Path.Visibility>
                                                            <MultiBinding Converter="{StaticResource UrlIsPlayingConverter}"
                                                                          ConverterParameter="Invert">
                                                                <Binding Path="Url"/>
                                                                <Binding Path="DataContext.NowPlayingUrl"
                                                                         RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            </MultiBinding>
                                                        </Path.Visibility>
                                                    </Path>
                                                    <!-- Animated equalizer (visible while this station is playing) -->
                                                    <ContentControl Template="{StaticResource EqualizerTemplate}"
                                                                    Width="20" Height="13"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl.Visibility>
                                                            <MultiBinding Converter="{StaticResource UrlIsPlayingConverter}">
                                                                <Binding Path="Url"/>
                                                                <Binding Path="DataContext.NowPlayingUrl"
                                                                         RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            </MultiBinding>
                                                        </ContentControl.Visibility>
                                                    </ContentControl>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource RowTitleText}"
                                                           Text="{Binding Name}" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowSubtitleDetailed}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Per-row hover-menu: Edit + Delete (Add lives at the bottom).
                                                 Hidden unless the mouse is over the row, so the list doesn't
                                                 carry two icons on every row all the time (Shared Framework
                                                 Spec §5). Hover only — NOT selection, or the buttons would
                                                 stay stuck on the selected row after the mouse leaves. -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <Binding Path="IsMouseOver"
                                                                             RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource GhostSquareButton}" Margin="0,0,6,0"
                                                        Content="{StaticResource EditGeometry}" ToolTip="Edit station"
                                                        Command="{Binding DataContext.EditStationCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostSquareButton}"
                                                        Content="{StaticResource DeleteGeometry}" ToolTip="Delete station"
                                                        Command="{Binding DataContext.DeleteStationCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </ctl:StatePanel>
                        </DockPanel>

                        <!-- ===== Search tab ===== -->
                        <DockPanel Visibility="{Binding IsChecked, ElementName=SearchTab,
                                   Converter={StaticResource BoolToVis}}">
                            <!-- Search field (Enter runs the AI search) -->
                            <Border DockPanel.Dock="Top" Height="40" CornerRadius="10" Margin="0,0,0,10"
                                    Background="{StaticResource FillSubtle}"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="12,0">
                                <DockPanel>
                                    <!-- Sparkle, not a magnifier (UX audit): this is the app's
                                         most AI-driven surface and now matches the Curate and DJ
                                         prompts, so the glyph means one thing everywhere. -->
                                    <Path DockPanel.Dock="Left" Data="{StaticResource SparkleGeometry}"
                                          Stretch="Uniform" Width="15" Height="15" Fill="#FF62A59B"
                                          VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <Grid>
                                        <TextBox x:Name="PromptBox" Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Foreground="{StaticResource TextBody}"
                                                 CaretBrush="{StaticResource Teal}" FontSize="13"
                                                 Text="{Binding SearchPrompt, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{StaticResource TextFaint}"
                                                   Text="Describe a vibe, then press Enter…">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PromptBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- Result status (+ "Find six more" on the right). No spinner here
                                 any more: while a search runs, the panel below owns the spinner
                                 and the progress line, so the two can't narrate in parallel. -->
                            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                <!-- Regenerate: fetch a different set for the same prompt -->
                                <Button DockPanel.Dock="Right" Style="{StaticResource CardPillButton}"
                                        Content="Find six more" Command="{Binding RegenerateSearchCommand}"
                                        ToolTip="Fetch a fresh set of stations for this prompt"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        Visibility="{Binding CanRegenerateSearch, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding SearchStatus}" FontSize="11.5"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <!-- The panel narrates while loading; don't say it twice. -->
                                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <ctl:StatePanel State="{Binding SearchPanelState}"
                                            EmptyContent="{Binding SearchEmptyMessage}"
                                            EmptyContentTemplate="{StaticResource PanelMessage}"
                                            LoadingContent="{Binding SearchProgress}"
                                            LoadingContentTemplate="{StaticResource PanelProgress}"
                                            ErrorContent="{Binding SearchError}"
                                            ErrorContentTemplate="{StaticResource PanelErrorMessage}">
                            <ListBox ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                     MouseDoubleClick="SearchResults_DoubleClick"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource StationRowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource FillSubtle}"
                                                    BorderBrush="{StaticResource HairlineSoft}" BorderThickness="1">
                                                <Grid>
                                                    <!-- Radio icon (hidden while this station is playing) -->
                                                    <Path Data="{StaticResource RadioGeometry}" Stretch="Uniform"
                                                          Width="17" Height="17" Stroke="#FF6F928C" StrokeThickness="1.4">
                                                        <Path.Visibility>
                                                            <MultiBinding Converter="{StaticResource UrlIsPlayingConverter}"
                                                                          ConverterParameter="Invert">
                                                                <Binding Path="Station.Url"/>
                                                                <Binding Path="DataContext.NowPlayingUrl"
                                                                         RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            </MultiBinding>
                                                        </Path.Visibility>
                                                    </Path>
                                                    <!-- Animated equalizer (visible while this station is playing) -->
                                                    <ContentControl Template="{StaticResource EqualizerTemplate}"
                                                                    Width="20" Height="13"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl.Visibility>
                                                            <MultiBinding Converter="{StaticResource UrlIsPlayingConverter}">
                                                                <Binding Path="Station.Url"/>
                                                                <Binding Path="DataContext.NowPlayingUrl"
                                                                         RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            </MultiBinding>
                                                        </ContentControl.Visibility>
                                                    </ContentControl>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource RowTitleText}"
                                                           Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding Reason}" ToolTip="{Binding Reason}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowSubtitleDetailed}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Reason}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AddSearchResultCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostSquareButton}">
                                                        <Setter Property="Content" Value="{StaticResource PlusGeometry}"/>
                                                        <Setter Property="ToolTip" Value="Add to Stations"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Content" Value="{StaticResource CheckGeometry}"/>
                                                                <Setter Property="ToolTip" Value="In your stations"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </ctl:StatePanel>
                        </DockPanel>

                        <!-- ===== History tab (Phase A: songs heard, About per row) ===== -->
                        <Grid Visibility="{Binding IsChecked, ElementName=HistoryTab,
                              Converter={StaticResource BoolToVis}}">
                            <ctl:StatePanel State="{Binding HistoryPanelState}"
                                            EmptyContent="Songs you hear will show up here."
                                            EmptyContentTemplate="{StaticResource PanelMessage}">
                            <ListBox ItemsSource="{Binding History}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource StationRowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource FillSubtle}"
                                                    BorderBrush="{StaticResource HairlineSoft}" BorderThickness="1">
                                                <Path Data="{StaticResource NoteGeometry}" Stretch="Uniform"
                                                      Width="15" Height="15" Stroke="#FF6F928C" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                                <!-- Compact row: Artist · Station · time on one line. -->
                                                <TextBlock Style="{StaticResource RowTitleText}"
                                                           Text="{Binding Title}" ToolTip="{Binding Title}"/>
                                                <TextBlock Style="{StaticResource RowSubtitleCompact}"
                                                           Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="2" Content="{Binding}"
                                                             ContentTemplate="{StaticResource SaveAndAboutActions}"
                                                             VerticalAlignment="Center" Focusable="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </ctl:StatePanel>
                        </Grid>
                    </Grid>
                    </DockPanel>
                    <!-- ================= end RADIO panel ================= -->

                    <!-- ================= LIBRARY panel (AI-curated local player) ================= -->
                    <DockPanel Visibility="{Binding ShowLibraryPanel, Converter={StaticResource BoolToVis}}">
                        <!-- Sub-nav: mirrors Radio's Stations/Search/History with the Library
                             equivalents (Shared Framework Spec pin 1) — underlined, not a
                             segmented pill, so it reads as a different nav level than the
                             Radio/Library mode toggle above it. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="CurateTab" GroupName="libraryTab" IsChecked="True"
                                         Style="{StaticResource UnderlineTab}" Content="Curate"/>
                            <RadioButton x:Name="SongsTab" GroupName="libraryTab"
                                         Style="{StaticResource UnderlineTab}" Content="Songs"/>
                        </StackPanel>

                        <Grid>
                        <!-- ===== Curate tab ===== -->
                        <DockPanel Visibility="{Binding IsChecked, ElementName=CurateTab,
                                   Converter={StaticResource BoolToVis}}">
                        <!-- Prompt (Enter curates a playlist from your saved songs) -->
                        <Border DockPanel.Dock="Top" Height="40" CornerRadius="10" Margin="0,0,0,10"
                                Background="{StaticResource FillSubtle}"
                                BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="12,0">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Data="{StaticResource SparkleGeometry}"
                                      Stretch="Uniform" Width="15" Height="15" Fill="#FF62A59B"
                                      VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <Grid>
                                    <TextBox x:Name="LibraryPromptBox" Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center" Foreground="{StaticResource TextBody}"
                                             CaretBrush="{StaticResource Teal}" FontSize="13"
                                             Text="{Binding LibraryPrompt, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding CurateCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{StaticResource TextFaint}"
                                               Text="Curate a playlist from your library…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=LibraryPromptBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Result status. No spinner: while curating, the panel below owns the
                             spinner and the progress line (same rule as Search). -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                            <TextBlock Text="{Binding LibraryStatus}" FontSize="11.5"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <!-- The panel narrates while curating; don't say it twice. -->
                                            <DataTrigger Binding="{Binding IsCurating}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Context card: "the thing I asked for" (query), distinct from "the
                             songs it produced" (queue) below (Shared Framework Spec §3). -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,12" CornerRadius="10" Padding="13,12"
                                Background="{StaticResource TealTint16}" BorderBrush="#4756C7BA" BorderThickness="1"
                                Visibility="{Binding HasCuratedPlaylist, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SparkleGeometry}" Stretch="Uniform"
                                          Width="12" Height="12" Fill="{StaticResource TealBright}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="CURATED PLAYLIST" Margin="7,0,0,0" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource TealText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CuratedPlaylistTitle}" FontSize="15" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,6,0,3"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}">
                                    <Run Text="{Binding CuratedQueue.Count, Mode=OneWay}"/>
                                    <Run Text=" songs · from your library"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Curated queue (double-click plays from that song) -->
                        <ctl:StatePanel State="{Binding CuratePanelState}"
                                        EmptyContent="{Binding CurateEmptyMessage}"
                                        EmptyContentTemplate="{StaticResource PanelMessage}"
                                        LoadingContent="{Binding CurateProgress}"
                                        LoadingContentTemplate="{StaticResource PanelProgress}"
                                        ErrorContent="{Binding CurateError}"
                                        ErrorContentTemplate="{StaticResource PanelErrorMessage}">
                        <ListBox ItemsSource="{Binding CuratedQueue}"
                                 MouseDoubleClick="Queue_DoubleClick"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource StationRowItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource FillSubtle}"
                                                BorderBrush="{StaticResource HairlineSoft}" BorderThickness="1">
                                            <Grid>
                                                <Path Data="{StaticResource NoteGeometry}" Stretch="Uniform"
                                                      Width="15" Height="15" Stroke="#FF6F928C" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <!-- Both conditions: the note comes back when playback stops, or the row would show
                                                                     an empty icon slot where the bars were (#56). -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsCurrent}" Value="True"/>
                                                                        <Condition Value="True"
                                                                                   Binding="{Binding DataContext.IsPlaying,
                                                                                             RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <ContentControl Template="{StaticResource EqualizerTemplate}"
                                                                Width="20" Height="13"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Top">
                                            <!-- Detailed row: the curator's reason earns two lines. -->
                                            <TextBlock Style="{StaticResource RowTitleText}"
                                                       Text="{Binding Title}" ToolTip="{Binding Title}"/>
                                            <TextBlock Style="{StaticResource RowSubtitleDetailed}"
                                                       Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </ctl:StatePanel>
                        </DockPanel>
                        <!-- ===== end Curate tab ===== -->

                        <!-- ===== Songs tab: every song saved to the library ===== -->
                        <Grid Visibility="{Binding IsChecked, ElementName=SongsTab,
                              Converter={StaticResource BoolToVis}}">
                            <ctl:StatePanel State="{Binding LibrarySongsPanelState}"
                                            EmptyContent="Songs you save while listening land here."
                                            EmptyContentTemplate="{StaticResource PanelMessage}">
                            <ListBox ItemsSource="{Binding LibrarySongs}"
                                     MouseDoubleClick="LibrarySong_DoubleClick"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource StationRowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource FillSubtle}"
                                                    BorderBrush="{StaticResource HairlineSoft}" BorderThickness="1">
                                                <Grid>
                                                    <Path Data="{StaticResource NoteGeometry}" Stretch="Uniform"
                                                          Width="15" Height="15" Stroke="#FF6F928C" StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <!-- Both conditions: the note comes back when playback stops, or the row would show
                                                                         an empty icon slot where the bars were (#56). -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsCurrent}" Value="True"/>
                                                                            <Condition Value="True"
                                                                                       Binding="{Binding DataContext.IsPlaying,
                                                                                                 RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <ContentControl Template="{StaticResource EqualizerTemplate}"
                                                                    Width="20" Height="13"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                                <!-- Compact row: uniform height across the whole
                                                     library, so the list stays scannable. -->
                                                <TextBlock Style="{StaticResource RowTitleText}"
                                                           Text="{Binding Title}" ToolTip="{Binding Title}"/>
                                                <TextBlock Style="{StaticResource RowSubtitleCompact}"
                                                           Text="{Binding Subtitle}" ToolTip="{Binding Description}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </ctl:StatePanel>
                        </Grid>
                        <!-- ===== end Songs tab ===== -->
                        </Grid>
                    </DockPanel>
                    <!-- ================= end LIBRARY panel ================= -->

                    <!-- ================= DJ panel (harvest + self-refilling queue) ================= -->
                    <DockPanel Visibility="{Binding ShowDjPanel, Converter={StaticResource BoolToVis}}">
                        <!-- ===== Session block (UX audit b06) =====
                             Five stacked control rows collapse to one. Idle: the prompt with
                             Start inside it. Running: the same block becomes the session's
                             record — vibe, state, counts — with End session as a quiet ghost
                             that only exists while there IS something to end. -->

                        <!-- The prompt field, IDLE ONLY. It used to serve both states, but sharing a
                             line with "Change vibe" (2.4x wider than "Start") cost the field ~90px
                             — down to about 17 visible characters — at exactly the moment the text
                             in it got long. And the vibe was then printed twice, here and in the
                             card below. Once a session runs this collapses and the card's own vibe
                             line becomes the editable one (#39). -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"
                                    Visibility="{Binding ShowDjPromptRow, Converter={StaticResource BoolToVis}}">

                            <Border Height="42" CornerRadius="10" Background="{StaticResource FillSubtle}"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    Padding="12,0,5,0">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource SparkleGeometry}"
                                          Stretch="Uniform" Width="15" Height="15" Fill="#FF62A59B"
                                          VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <!-- Start lives inside the field it acts on, instead of a
                                         second full-width pill below it. -->
                                    <Button DockPanel.Dock="Right"
                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                            Command="{Binding DjPromptSubmitCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AboutPillButton}">
                                                <Setter Property="Content" Value="Start"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjRunning}" Value="True">
                                                        <Setter Property="Content" Value="Change vibe"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChangingDjVibe}" Value="True">
                                                        <Setter Property="Content" Value="Finding…"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Grid>
                                        <TextBox x:Name="DjPromptBox" Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Foreground="{StaticResource TextBody}"
                                                 CaretBrush="{StaticResource Teal}" FontSize="13"
                                                 Text="{Binding DjPrompt, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding DjPromptSubmitCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{StaticResource TextFaint}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Text" Value="Describe a vibe…"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DjPromptBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDjRunning}" Value="True">
                                                            <Setter Property="Text" Value="Change the vibe…"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <TextBlock Margin="2,9,0,0" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="We'll find stations, record the good bits, and keep it playing.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDjRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Running: the session's record -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,16" CornerRadius="10" Padding="13,11"
                                Background="{StaticResource TealTint10}" BorderBrush="#3D56C7BA"
                                BorderThickness="1"
                                Visibility="{Binding IsDjRunning, Converter={StaticResource BoolToVis}}">
                            <!-- A StackPanel, not a DockPanel with End session docked right: docking
                                 it stole ~130px from every line beside it, so the vibe wrapped in a
                                 200px column when the whole point of #39 is giving it the panel's
                                 full width. It now sits on its own line under the status. -->
                            <StackPanel>
                                <StackPanel>
                                    <!-- DockPanel so the action pins to the card's top-RIGHT corner
                                         rather than trailing the eyebrow text. -->
                                    <DockPanel Margin="0,0,0,7">
                                        <!-- Docked child FIRST: DockPanel.LastChildFill defaults to
                                             true, so a Dock="Right" element placed last would
                                             stretch across the row instead of pinning to the edge. -->
                                        <Button Content="Change vibe" DockPanel.Dock="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CardPillButton}"
                                                ToolTip="Re-tune this session to a new vibe"
                                                Command="{Binding BeginEditDjVibeCommand}"
                                                Visibility="{Binding ShowDjSessionVibeText,
                                                             Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Amber while bridging a live station, teal once the
                                             mix itself is playing. -->
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource TealBright}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDjWarmingUp}" Value="True">
                                                            <Setter Property="Fill" Value="#FFE6C88A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                From="1" To="0.3" Duration="0:0:0.9"
                                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="THIS SESSION" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TealText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    </DockPanel>

                                    <!-- READING: the vibe as text. Wraps freely — the card grows
                                         downward and the Mix list below absorbs it. Deliberately no
                                         MaxHeight + TextTrimming, which is what used to be here: on
                                         a wrapping TextBlock that pair collapses the text to a
                                         single ellipsised line (the same WPF behaviour that made
                                         #38's obvious fix unusable), so a two-line vibe was being
                                         cut to one for no reason. -->
                                    <TextBlock Text="{Binding DjSessionVibe}" FontSize="13.5" FontWeight="Medium"
                                               Foreground="{StaticResource TextBody}" TextWrapping="Wrap"
                                               Visibility="{Binding ShowDjSessionVibeText,
                                                            Converter={StaticResource BoolToVis}}"/>

                                    <!-- EDITING: the same line becomes the field, at the card's full
                                         width instead of the ~142px the old shared row left it. -->
                                    <StackPanel Visibility="{Binding IsEditingDjVibe,
                                                             Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="NEW VIBE" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TealText}" Margin="0,4,0,6"/>
                                        <Border CornerRadius="8" Background="{StaticResource FillSubtle}"
                                                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                Padding="9,7">
                                            <!-- AcceptsReturn=False so Enter submits rather than
                                                 inserting a newline; MinLines/MaxLines give it two
                                                 lines to start and scroll past four. -->
                                            <TextBox x:Name="DjVibeEditBox" Background="Transparent"
                                                     BorderThickness="0" AcceptsReturn="False"
                                                     TextWrapping="Wrap" MinLines="2" MaxLines="4"
                                                     VerticalScrollBarVisibility="Auto"
                                                     FontSize="13.5" Foreground="{StaticResource TextBody}"
                                                     CaretBrush="{StaticResource Teal}"
                                                     Text="{Binding DjPrompt, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding DjPromptSubmitCommand}"/>
                                                    <KeyBinding Key="Escape" Command="{Binding CancelEditDjVibeCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <!-- Style as an ELEMENT only. Setting it as an attribute
                                                 as well collides — the same mistake that shipped
                                                 once already in this file. -->
                                            <Button Command="{Binding DjPromptSubmitCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AboutPillButton}">
                                                        <Setter Property="Content" Value="Update vibe"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChangingDjVibe}" Value="True">
                                                                <Setter Property="Content" Value="Finding…"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Cancel" Margin="8,0,0,0"
                                                    Style="{StaticResource GhostPillButton}"
                                                    Command="{Binding CancelEditDjVibeCommand}"/>
                                        </StackPanel>

                                        <!-- The one thing a listener needs to know before pressing
                                             it: this steers, it doesn't start over. -->
                                        <TextBlock Text="Keeps the mix collected so far and re-tunes from here."
                                                   FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DjStatus}" FontSize="11.5" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                               Visibility="{Binding ShowDjSessionVibeText,
                                                            Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Steps aside while editing: Update / Cancel own the card then, and
                                     a third button beside them invites ending the session by accident
                                     when the intent was only to change it. -->
                                <Button Content="End session" HorizontalAlignment="Right"
                                        Style="{StaticResource GhostPillButton}" Margin="0,11,0,0"
                                        Command="{Binding StopDjCommand}"
                                        Visibility="{Binding ShowDjSessionVibeText,
                                                     Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Sub-nav (UX audit b08): content first, like Stations-then-Search and
                             Songs-then-Curate. The mix is what the mode is FOR; the stations
                             feeding it are the supporting detail. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="DjMixTab" GroupName="djTab" IsChecked="True"
                                         Style="{StaticResource UnderlineTab}" Content="Mix"/>
                            <RadioButton x:Name="DjSourcesTab" GroupName="djTab"
                                         Style="{StaticResource UnderlineTab}" Content="Sources"/>
                        </StackPanel>

                        <Grid>
                            <!-- ===== Mix tab: the session's queue — played, playing, upcoming.
                                 During warm-up this is where the staged checklist lands, which is
                                 the space that used to claim nothing was happening. ===== -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=DjMixTab,
                                       Converter={StaticResource BoolToVis}}">
                                <ctl:StatePanel State="{Binding DjMixPanelState}"
                                                EmptyContent="{Binding DjMixEmptyMessage}"
                                                EmptyContentTemplate="{StaticResource PanelMessage}"
                                                LoadingContent="{Binding DjProgress}"
                                                LoadingContentTemplate="{StaticResource PanelProgress}"
                                                ErrorContent="{Binding DjError}"
                                                ErrorContentTemplate="{StaticResource PanelErrorMessage}">
                                <!-- ScrollUnit=Item is load-bearing, not tidying: ListCentering
                                     works in item units, so it must not depend on the default. -->
                                <ListBox ItemsSource="{Binding DjMix}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.ScrollUnit="Item"
                                         ctl:ListCentering.CurrentIndex="{Binding DjMixCurrentIndex}"
                                         ItemContainerStyle="{StaticResource StationRowItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource FillSubtle}"
                                                        BorderBrush="{StaticResource HairlineSoft}" BorderThickness="1">
                                                    <Grid>
                                                        <Path Data="{StaticResource NoteGeometry}" Stretch="Uniform"
                                                              Width="15" Height="15" Stroke="#FF6F928C" StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Style.Triggers>
                                                                        <!-- Both conditions: the note comes back when playback stops, or the row would show
                                                                             an empty icon slot where the bars were (#56). -->
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsCurrent}" Value="True"/>
                                                                                <Condition Value="True"
                                                                                           Binding="{Binding DataContext.IsPlaying,
                                                                                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <ContentControl Template="{StaticResource EqualizerTemplate}"
                                                                        Width="20" Height="13" Focusable="False"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsCurrent,
                                                                                     Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                                    <!-- Played rows recede so what's still coming reads first. -->
                                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitleText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPlayed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource TealText}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource RowSubtitleCompact}"
                                                               Text="{Binding Artist}" ToolTip="{Binding Artist}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </ctl:StatePanel>
                            </DockPanel>
                            <!-- ===== end Mix tab ===== -->

                            <!-- ===== Sources tab: currently-connected stations ===== -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=DjSourcesTab,
                                       Converter={StaticResource BoolToVis}}">
                                <ctl:StatePanel State="{Binding DjSourcesPanelState}"
                                                EmptyContent="{Binding DjSourcesEmptyMessage}"
                                                EmptyContentTemplate="{StaticResource PanelMessage}"
                                                LoadingContent="{Binding DjProgress}"
                                                LoadingContentTemplate="{StaticResource PanelProgress}"
                                                ErrorContent="{Binding DjError}"
                                                ErrorContentTemplate="{StaticResource PanelErrorMessage}">
                                <ListBox ItemsSource="{Binding DjHarvesters}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource StationRowItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                        VerticalAlignment="Top"
                                                        Background="{StaticResource FillSubtle}"
                                                        BorderBrush="{StaticResource HairlineSoft}" BorderThickness="1">
                                                    <Path Data="{StaticResource RadioGeometry}" Stretch="Uniform"
                                                          Width="15" Height="15" Stroke="#FF6F928C" StrokeThickness="1.4"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RowTitleText}"
                                                               Text="{Binding Label}" ToolTip="{Binding Label}"/>
                                                    <TextBlock Style="{StaticResource RowSubtitleCompact}"
                                                               Text="{Binding StatusText}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </ctl:StatePanel>
                            </DockPanel>
                            <!-- ===== end Sources tab =====
                                 (There is no separate History tab any more: the queue keeps every
                                 track it has played, so the Mix list above IS the session record.) -->
                        </Grid>
                    </DockPanel>
                    <!-- ================= end DJ panel ================= -->
                    </Grid>
                </DockPanel>
            </Border>

            <!-- RIGHT: now playing + transport (content reworked in R5) -->
            <Grid Grid.Column="1" Margin="44,34,44,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Now playing (vertically centred). Swaps with the About reading view. =====
                     Centred by a pair of star-height SPACERS rather than VerticalAlignment="Center",
                     and that is the fix for #38. A centred panel taller than its row is centred on
                     its DESIRED size, so the overflow splits equally above and below and the first
                     thing inside it — the "NOW PLAYING" eyebrow with its Copy button — slides off
                     the top of the screen. Measured before the fix: a one-line title left the
                     eyebrow 8px inside the row, two lines put it 50px above, three lines 107px.

                     With star spacers the Grid gives the Auto row its desired height first and
                     shares what remains between the spacers, so as the title grows the TOP spacer
                     collapses to zero before anything else moves. The eyebrow cannot rise past the
                     top edge, overflow can only spill downward, and the last child (the recent
                     list) is what gets cut instead of the header. Short titles still centre exactly
                     as before. -->
                <Grid Grid.Row="0" MaxWidth="440" HorizontalAlignment="Left"
                      Visibility="{Binding ShowNowPlaying, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                <StackPanel Grid.Row="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="NOW PLAYING" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF6F8C87" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource TitleIconButton}" Click="CopyNowPlaying_Click"
                                Content="{StaticResource CopyGeometry}" ToolTip="Copy title &amp; artist"
                                Width="32" Height="32" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasTrackInfo, Converter={StaticResource BoolToVis}}"/>
                        <!-- No save button here. It used to duplicate the one on this same song's
                             row in the list below, which meanwhile insisted the song "wasn't
                             recorded while it played" — two buttons for one song and one of them
                             lying (#37). The list row owns saving now, for every song including
                             this one. -->
                    </StackPanel>

                    <!-- Idle quiets to 28px Light + a mode-specific next step (UX audit: an
                         absence must not be the loudest element on screen). -->
                    <!-- Wraps freely: the star-spacer grid above absorbs the growth, so a long
                         title no longer costs the header row. Deliberately NOT capped with
                         MaxHeight + TextTrimming — WPF's TextBlock will not wrap-then-trim, and every
                         arrangement of those two collapsed the title to a single ellipsised line
                         (MaxHeight alone cut it through the middle of the glyphs instead). Tooltip
                         carries the full text for the case where it does get clipped. -->
                    <TextBlock Text="{Binding NowPlayingTitle}" TextWrapping="Wrap"
                               ToolTip="{Binding NowPlayingTitle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="44"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="LineHeight" Value="48"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNowPlayingIdle}" Value="True">
                                        <Setter Property="FontSize" Value="28"/>
                                        <Setter Property="FontWeight" Value="Light"/>
                                        <Setter Property="LineHeight" Value="32"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding IdleHint}" FontSize="15" FontWeight="Light"
                               Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"
                               Visibility="{Binding IsNowPlayingIdle, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding NowPlayingArtist}" FontSize="20" FontWeight="Light"
                               Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Station chip (source of truth for what's playing) -->
                    <Border HorizontalAlignment="Left" Margin="0,22,0,0" CornerRadius="10"
                            Padding="11,7,13,7" Background="#0DFFFFFF"
                            BorderBrush="#17FFFFFF" BorderThickness="1"
                            Visibility="{Binding HasStation, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource RadioGeometry}" Stretch="Uniform" Width="15" Height="15"
                                  Stroke="{StaticResource TealBright}" StrokeThickness="1.4"/>
                            <TextBlock Text="{Binding NowPlayingStation}" Margin="8,0,0,0" FontSize="12.5"
                                       Foreground="#FFCFDEDB" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- DJ Mode: the "why this song" line, promoted (UX audit b11). It's the
                         mode's signature and was the hardest thing to read on the screen — 12.5px
                         muted italic floating on artwork. Now 15px Secondary on a solid surface,
                         attributed so it's clear who's talking. -->
                    <Border HorizontalAlignment="Left" Margin="0,20,0,0" CornerRadius="10"
                            Padding="14,12" MaxWidth="430" Background="#B8071614"
                            BorderBrush="#2E56C7BA" BorderThickness="1"
                            Visibility="{Binding ShowDjIntro, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Path Data="{StaticResource SparkleGeometry}" Stretch="Uniform"
                                      Width="12" Height="12" Fill="{StaticResource TealBright}"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="YOUR DJ" Margin="7,0,0,0" FontSize="10.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource TealText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DjIntroLine}" FontSize="15" FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- Status row: connecting spinner, otherwise LIVE badge + codec -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Ellipse Stroke="#33FFFFFF" StrokeThickness="2"/>
                                <Path Stroke="{StaticResource Teal}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 7,1 A 6,6 0 0 1 13,7"/>
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Animated equalizer + LIVE badge while a radio stream plays -->
                        <ContentControl Template="{StaticResource EqualizerTemplate}" Height="13"
                                        VerticalAlignment="Center" Margin="0,0,12,0"
                                        Visibility="{Binding ShowLiveBadge, Converter={StaticResource BoolToVis}}"/>
                        <!-- LIVE, or BRIDGING in amber while DJ mode is playing a station to
                             cover the gap until the mix fills — the two are genuinely different
                             promises and shouldn't look identical. -->
                        <Border CornerRadius="7" Padding="9,3" BorderThickness="1" VerticalAlignment="Center"
                                Visibility="{Binding ShowLiveBadge, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1F56C7BA"/>
                                    <Setter Property="BorderBrush" Value="#4056C7BA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDjWarmingUp}" Value="True">
                                            <Setter Property="Background" Value="#24E6C88A"/>
                                            <Setter Property="BorderBrush" Value="#66E6C88A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TealBright}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDjWarmingUp}" Value="True">
                                                    <Setter Property="Fill" Value="#FFE6C88A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0.28" Duration="0:0:0.8"
                                                        AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Margin="6,0,0,0" FontSize="10.5" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="LIVE"/>
                                            <Setter Property="Foreground" Value="#FF8FE0D4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDjWarmingUp}" Value="True">
                                                    <Setter Property="Text" Value="BRIDGING"/>
                                                    <Setter Property="Foreground" Value="#FFE6C88A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- Codec pairs with the LIVE badge ("LIVE · AAC" — UX audit: alone and
                             faint it read as debris) and hides when the codec is unknown. -->
                        <TextBlock Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowLiveBadge}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlayingFormat}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="· "/><Run Text="{Binding NowPlayingFormat, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Reading-view triggers. "About this song" needs an API key; "Lyrics" does
                         not, because LRCLIB is keyless — so on a fresh install this row can hold
                         one, both or neither. -->
                    <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                        <Button Style="{StaticResource AboutPillButton}" Content="About this song"
                                Command="{Binding OpenAboutCommand}"
                                Visibility="{Binding CanShowAbout, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource AboutPillButton}" Content="Lyrics"
                                Tag="{StaticResource LyricsGeometry}"
                                Command="{Binding OpenLyricsCommand}" Margin="10,0,0,0"
                                Visibility="{Binding CanShowLyrics, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- "Recently on this station" (Radio only) — the space Library uses for a
                         scrubber has no seekable equivalent on a live stream, so it's used for
                         this instead (Shared Framework Spec §4a, pin 2). -->
                    <StackPanel Margin="0,28,0,0"
                                Visibility="{Binding ShowRecentOnStation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="RECENTLY ON THIS STATION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF6F8C87" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding RecentOnStation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextBody}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Artist, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding RelativeTime, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" Content="{Binding}"
                                                         ContentTemplate="{StaticResource SaveAndAboutActions}"
                                                         VerticalAlignment="Center" Focusable="False"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </Grid>

                <!-- ===== About this track reading view (swaps with Now Playing) =====
                     Stretches to the right column's width; bottom margin keeps the footer off
                     the transport row below. -->
                <!-- Negative top margin lifts the header up to align with the left-panel tabs
                     (which sit higher than this column's top padding). -->
                <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Margin="0,-18,0,8"
                      Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Reading scrim: dark behind the text for legibility, fading to transparent
                         on the right so the wave art still peeks through. Behind all content. -->
                    <Rectangle Grid.RowSpan="3" IsHitTestVisible="False" Margin="-20,-12,-44,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F2050D0C" Offset="0"/>
                                <GradientStop Color="#EE050D0C" Offset="0.62"/>
                                <GradientStop Color="#C2050D0C" Offset="0.84"/>
                                <GradientStop Color="#00050D0C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Header: back button + eyebrow -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AboutBackButton}" Command="{Binding BackToNowPlayingCommand}"
                                ToolTip="Back to now playing"/>
                        <Path Data="{StaticResource SparkleGeometry}" Stretch="Uniform" Width="15" Height="15"
                              Fill="#FF62D2C4" VerticalAlignment="Center" Margin="13,0,0,0"
                              Visibility="{Binding IsAboutOverlay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="ABOUT THIS SONG" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8FD6CB" VerticalAlignment="Center"
                                   Visibility="{Binding IsAboutOverlay, Converter={StaticResource BoolToVis}}"/>
                        <Path Data="{StaticResource LyricsGeometry}" Stretch="Uniform" Width="14" Height="14"
                              Fill="#FF62D2C4" VerticalAlignment="Center" Margin="13,0,0,0"
                              Visibility="{Binding IsLyricsOverlay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="LYRICS" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8FD6CB" VerticalAlignment="Center"
                                   Visibility="{Binding IsLyricsOverlay, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Scroll region: track context (title + artist) scrolls together with the
                         loading / result / error content, so it frees vertical room when scrolled. -->
                    <ScrollViewer x:Name="AboutScroll" Grid.Row="1" Margin="0,20,0,0" Padding="0,0,8,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Context: the SUBJECT track title + artist (frozen when the briefing
                                 opened, so it stays put if a new song starts; scrolls with content) -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{Binding OverlaySubjectTitle}" FontSize="24" FontWeight="Light"
                                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OverlaySubjectArtist}" FontSize="14" Margin="0,3,0,0"
                                           Foreground="#FF9FB3AE" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                        <Grid>
                            <!-- Loading skeleton -->
                            <StackPanel Visibility="{Binding IsOverlayLoading, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Grid Width="13" Height="13" Margin="0,0,9,0" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform/>
                                        </Grid.RenderTransform>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                        <Ellipse Stroke="#4D56C7BA" StrokeThickness="1.6"/>
                                        <Path Stroke="#FF62D2C4" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 6.5,1 A 5.5,5.5 0 0 1 12,6.5"/>
                                    </Grid>
                                    <TextBlock Text="Gathering notes on this song…" FontSize="12.5"
                                               Foreground="#FF8FD6CB" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Shimmer placeholder bars (staggered opacity pulse) -->
                                <StackPanel x:Name="ShimmerBars">
                                    <StackPanel.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="10"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Setter Property="Margin" Value="0,0,0,13"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="#14FFFFFF"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Border x:Name="sb1" Width="130"/>
                                    <Border x:Name="sb2" Width="430"/>
                                    <Border x:Name="sb3" Width="404"/>
                                    <Border x:Name="sb4" Width="378"/>
                                    <Border x:Name="sb5" Width="198"/>
                                    <Border x:Name="sb6" Width="105" Background="#1F56C7BA" Margin="0,9,0,13"/>
                                    <Border x:Name="sb7" Width="416"/>
                                    <Border x:Name="sb8" Width="300"/>
                                    <StackPanel.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="sb1" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7"/>
                                                    <DoubleAnimation Storyboard.TargetName="sb2" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7" BeginTime="0:0:0.10"/>
                                                    <DoubleAnimation Storyboard.TargetName="sb3" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7" BeginTime="0:0:0.20"/>
                                                    <DoubleAnimation Storyboard.TargetName="sb4" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7" BeginTime="0:0:0.30"/>
                                                    <DoubleAnimation Storyboard.TargetName="sb5" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7" BeginTime="0:0:0.40"/>
                                                    <DoubleAnimation Storyboard.TargetName="sb6" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7" BeginTime="0:0:0.50"/>
                                                    <DoubleAnimation Storyboard.TargetName="sb7" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7" BeginTime="0:0:0.60"/>
                                                    <DoubleAnimation Storyboard.TargetName="sb8" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7" BeginTime="0:0:0.70"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </StackPanel.Triggers>
                                </StackPanel>
                            </StackPanel>

                            <!-- Result: THE SONG / THE ARTIST / NOTABLE (About overlay only) -->
                            <StackPanel Visibility="{Binding ShowAboutResult, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="THE SONG" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FF62D2C4" Margin="0,0,0,9"/>
                                    <TextBlock Text="{Binding TrackInfo.Song}" FontSize="14" LineHeight="23"
                                               Foreground="#FFCDD9D6" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,22,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrackInfo.Artist}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="THE ARTIST" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FF62D2C4" Margin="0,0,0,9"/>
                                    <TextBlock Text="{Binding TrackInfo.Artist}" FontSize="14" LineHeight="23"
                                               Foreground="#FFCDD9D6" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,22,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrackInfo.Notable.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="NOTABLE" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FF62D2C4" Margin="0,0,0,11"/>
                                    <ItemsControl ItemsSource="{Binding TrackInfo.Notable}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,8,11,0"
                                                             Fill="{StaticResource Teal}" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14"
                                                               LineHeight="21" Foreground="#FFCDD9D6" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Error -->
                            <!-- Result: the words. Monospace-ish line height and preserved line
                                 breaks, because lyrics ARE their line breaks. -->
                            <StackPanel Visibility="{Binding ShowLyricsResult, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LyricsText}" FontSize="14.5" LineHeight="26"
                                           Foreground="#FFCDD9D6" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LyricsText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Not an error: LRCLIB knows the track, it just has no words for
                                     it (an instrumental, or nobody has written them up yet). -->
                                <TextBlock Text="{Binding LyricsNote}" FontSize="13.5" LineHeight="21"
                                           FontStyle="Italic" Foreground="#FF9FB3AE" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LyricsNote}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Lyrics from LRCLIB" FontSize="11" Margin="0,24,0,0"
                                           Foreground="#FF5F736F"/>
                            </StackPanel>

                            <TextBlock Visibility="{Binding IsOverlayError, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding OverlayError}" FontSize="13.5" LineHeight="21"
                                       Foreground="#FF7D938E" TextWrapping="Wrap"/>
                        </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom fade: the scrolled text dissolves at the fold instead of clipping
                         mid-line (Shared Framework Spec pin 8). Non-hit-testable so scrolling and
                         the scrollbar underneath still work; sits above the ScrollViewer in
                         z-order (later sibling) but only covers its own reserved band at the
                         bottom of the scroll region. -->
                    <Rectangle Grid.Row="1" Height="38" VerticalAlignment="Bottom" Margin="0,0,8,0"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00050D0C" Offset="0"/>
                                <GradientStop Color="#F2050D0C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Footer: regenerate (result/error) + disclaimer. About only — there is
                         nothing to regenerate about a lyric sheet, and the AI disclaimer would be
                         a lie over text fetched verbatim from a database. -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"
                                Background="Transparent"
                                Visibility="{Binding IsAboutOverlay, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"
                                Padding="0,13,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <!-- Shown in Result and Error (retry); hidden while loading. -->
                                <Button Content="Regenerate" Command="{Binding RegenerateAboutCommand}"
                                        Margin="0,0,14,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AboutLinkButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverlayLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="AI-generated · may be imperfect" FontSize="11"
                                           Foreground="#FF5F736F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ===== Transport + volume =====
                     On a defined surface strip (UX audit): the artwork's bright diagonal runs
                     straight through this area, and a gradient scrim alone still left the
                     controls looking like they floated on it. Negative margins cancel the
                     pane's padding so the strip reaches the window edges; Padding restores the
                     inner spacing.

                     The strip FADES IN over its top 62px rather than starting at full opacity
                     behind a hairline, which drew a hard band across the artwork. MappingMode
                     Absolute is what makes that work: the strip's height changes with the mode
                     (seek row and Up next come and go), so a proportional gradient would move the
                     boundary around, while SpreadMethod=Pad holds the solid tone everywhere below
                     62px whatever the height. The top padding matches the fade so no control ever
                     sits in the ramp. -->
                <!-- The 62px ramp is generous because it sits under artwork. While the reading view
                     is open it sits under TEXT instead, and this row is Auto in a star row above —
                     so every pixel of it is a pixel the reading view doesn't get (#59). Compact
                     while reading: the padding and the fade shrink together, because the rule above
                     is that no control may sit inside the ramp. -->
                <Border Grid.Row="1" Margin="-44,0,-44,-30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="44,62,44,30"/>
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,62"
                                                         MappingMode="Absolute" SpreadMethod="Pad">
                                        <GradientStop Offset="0" Color="#00040B0A"/>
                                        <GradientStop Offset="0.55" Color="#78040B0A"/>
                                        <GradientStop Offset="1" Color="#B8040B0A"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowOverlay}" Value="True">
                                    <Setter Property="Padding" Value="44,20,44,30"/>
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,20"
                                                                 MappingMode="Absolute" SpreadMethod="Pad">
                                                <GradientStop Offset="0" Color="#00040B0A"/>
                                                <GradientStop Offset="0.55" Color="#78040B0A"/>
                                                <GradientStop Offset="1" Color="#B8040B0A"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                <StackPanel>
                    <!-- Seek bar (library mode only; radio streams have no timeline) -->
                    <Grid Margin="0,0,0,18" Width="440" HorizontalAlignment="Left"
                          Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="11.5"
                                   Foreground="#FF8AA39E" VerticalAlignment="Center" MinWidth="34"/>
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SeekBarSlider}"
                                Margin="12,0" Minimum="0" Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5"
                                   Foreground="#FF8AA39E" VerticalAlignment="Center" MinWidth="34"
                                   TextAlignment="Right"/>
                    </Grid>

                    <!-- Transport, with volume on the SAME row, right-aligned (design review
                         "Volume Control Options", option A). Volume used to own a full row styled
                         identically to the seek bar, which read as "these two matter equally";
                         it's set once a session. Moving it up buys back a row of artwork and is
                         the standard desktop-player arrangement. Width 440 aligns the group's
                         right edge with the seek bar's end above, so the controls read as one
                         block rather than drifting to the far pane edge. -->
                    <Grid Width="440" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource RoundGhostButton}" VerticalAlignment="Center"
                                    Command="{Binding PrevStationCommand}"
                                    Content="{StaticResource PrevGeometry}" ToolTip="Previous"/>
                            <Button Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseLabel}"
                                    VerticalAlignment="Center" Margin="16,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource PauseGeometry}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource RoundGhostButton}" VerticalAlignment="Center"
                                    Command="{Binding NextStationCommand}"
                                    Content="{StaticResource NextGeometry}" ToolTip="Next"/>
                            <Button Style="{StaticResource RoundGhostButton}" VerticalAlignment="Center"
                                    Command="{Binding StopCommand}" Margin="16,0,0,0"
                                    Content="{StaticResource StopGeometry}" ToolTip="Stop"/>
                        </StackPanel>

                        <!-- Volume group. The readout appears on hover only: a permanently visible
                             "100" tells the user a number they set themselves. The tooltip keeps
                             it readable without hovering the slider itself. -->
                        <StackPanel x:Name="VolumeGroup" Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding VolumePercent, StringFormat=Volume {0}}">
                            <Path Data="{StaticResource VolumeGeometry}" Stretch="Uniform"
                                  Width="16" Height="16" Fill="#FF8AA39E" VerticalAlignment="Center"/>
                            <Slider Style="{StaticResource MutedSlider}" Width="96" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding Volume, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding VolumePercent}" FontSize="11" Width="26"
                                       Margin="8,0,0,0" TextAlignment="Right"
                                       Foreground="#FF8AA39E" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True" Binding="{Binding IsMouseOver,
                                                         ElementName=VolumeGroup}">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- "Up next" (DJ mode): the thing a listener most often wants to know
                         without switching panels. Only when there's actually a next track. -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                                Visibility="{Binding HasUpNext, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="UP NEXT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#FF6F8C87" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UpNext}" Margin="9,0,0,0" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                </Border>
            </Grid>
        </Grid>

            </Grid>

            <!-- Scrim while a modal dialog is open (UX audit): without it the running app keeps
                 competing for attention behind the dialog. Spans both rows so the title bar dims
                 too; AppDialog sets the attached flag on its owner. -->
            <Rectangle Grid.RowSpan="2" Panel.ZIndex="99" Fill="#99050D0C" IsHitTestVisible="False"
                       Visibility="{Binding Path=(ctl:AppDialog.IsDimmed),
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Border>
</Window>
