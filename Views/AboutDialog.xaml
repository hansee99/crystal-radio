<ctl:AppDialog x:Class="RadioPlayer.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RadioPlayer.Controls"
        Title="About" SizeToContent="WidthAndHeight"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBody}">

    <StackPanel Margin="24,4,24,24" Width="352">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/app-256.png" Width="48" Height="48" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Crystal Radio" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,18,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource TextSecondary}"
                   Text="A lightweight player for internet radio streams (Icecast/Shoutcast), with now-playing info, Windows media-control integration, and taskbar controls."/>

        <TextBlock Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource TextSecondary}"
                   Text="Describe what you want to hear and it finds real stations that actually play. Optional and online-only; the player works fully without it."/>

        <TextBlock Margin="0,16,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}"
                   Text="Audio engine: BASS (un4seen) — free for non-commercial use. Licensed under the PolyForm Noncommercial License 1.0.0."/>

        <Button Content="Close" Style="{StaticResource DialogPrimaryButton}"
                IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,22,0,0"/>
    </StackPanel>
</ctl:AppDialog>
