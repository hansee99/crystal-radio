<ctl:AppDialog x:Class="RadioPlayer.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RadioPlayer.Controls"
        Title="Options" Width="480" SizeToContent="Height"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource UiFont}"
        TextElement.Foreground="{StaticResource TextBody}">

    <StackPanel Margin="24,4,24,24">
        <TextBlock Style="{StaticResource DialogSectionHeader}" Text="AI-assisted search"/>
        <TextBlock Style="{StaticResource DialogHint}" Margin="0,2,0,0"
                   Text="Leave blank to turn it off — the player works fine without it."/>

        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="Anthropic API key"/>
        <TextBox x:Name="ApiKeyBox" Style="{StaticResource DialogTextBox}"/>

        <TextBlock x:Name="EnvHintText" Style="{StaticResource DialogHint}" Visibility="Collapsed"/>

        <TextBlock Style="{StaticResource DialogHint}"
                   Text="Your key is stored securely on this PC. Get one at console.anthropic.com."/>

        <TextBlock Style="{StaticResource DialogSectionHeader}" Text="Saved songs" Margin="0,24,0,2"/>
        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="Library folder"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0"
                    Style="{StaticResource DialogGhostButton}" Click="BrowseLibrary_Click"/>
            <TextBox x:Name="LibraryFolderBox" Style="{StaticResource DialogTextBox}"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Style="{StaticResource DialogHint}"
                   Text="Songs you save land here, named &quot;Artist - Title&quot;. For personal use only — respect the stations' terms."/>

        <TextBlock Style="{StaticResource DialogSectionHeader}" Text="DJ mode" Margin="0,24,0,2"/>

        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="DJ voice"/>
        <ComboBox x:Name="DjVoiceBox" Style="{StaticResource DialogComboBox}"/>
        <TextBlock Style="{StaticResource DialogHint}"
                   Text="How the DJ introduces tracks and fills the gaps between them."/>

        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="Stations to listen to at once"/>
        <TextBox x:Name="HarvesterCountBox" Style="{StaticResource DialogTextBox}"/>
        <TextBlock Style="{StaticResource DialogHint}"
                   Text="More stations means more variety, but more bandwidth and more AI cost — every song collected gets a description written for it."/>

        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="Disk space for DJ mode (MB)"/>
        <TextBox x:Name="DiskSpaceBox" Style="{StaticResource DialogTextBox}"/>
        <TextBlock Style="{StaticResource DialogHint}"
                   Text="Collected songs are kept only while the mix might use them, then the oldest are deleted. Songs you save to your library are never touched."/>

        <TextBlock Style="{StaticResource DialogSectionHeader}" Text="Track edges" Margin="0,24,0,2"/>
        <TextBlock Style="{StaticResource DialogHint}" Margin="0,2,0,0"
                   Text="Songs recorded off live radio don't always start and end exactly on the beat. These hide an imperfect cut by giving up a moment of the track. 0 turns them off."/>

        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="Skip the first … seconds of each track"/>
        <TextBox x:Name="IntroSkipBox" Style="{StaticResource DialogTextBox}"/>

        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="Stop … seconds before the end"/>
        <TextBox x:Name="OutroGuardBox" Style="{StaticResource DialogTextBox}"/>

        <TextBlock Style="{StaticResource DialogHint}" Foreground="#FFC7B486" Margin="0,18,0,0"
                   Text="Changes apply next time you start Crystal Radio."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
            <Button Content="Save" IsDefault="True" Margin="10,0,0,0"
                    Style="{StaticResource DialogPrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</ctl:AppDialog>
