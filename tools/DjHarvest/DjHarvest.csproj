<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- StreamRecorder marshals its SegmentCompleted event through a WPF Dispatcher, and this
         tool pumps one; UseWPF brings in WindowsBase (Dispatcher / DispatcherTimer). -->
    <UseWPF>true</UseWPF>
    <!-- Match the app: the referenced project is x64 (native BASS). -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\crystal-radio.csproj" />
  </ItemGroup>

  <!-- Native BASS DLLs (x64). Content doesn't flow across a ProjectReference, so link the
       app's copies next to this tool's exe. bass_aac is needed for AAC stations. -->
  <ItemGroup>
    <Content Include="..\..\native\x64\bass.dll" Link="bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\native\x64\bass_aac.dll" Link="bass_aac.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
