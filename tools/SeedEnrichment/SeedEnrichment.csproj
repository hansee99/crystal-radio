<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Match the app: the referenced project is x64 (native BASS/ONNX). -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RadioPlayer.csproj" />
  </ItemGroup>

  <!-- The embedding provider loads these from AppContext.BaseDirectory\MlAssets.
       (Content does not flow across a ProjectReference, so link them here too.) -->
  <ItemGroup>
    <Content Include="..\..\MlAssets\all-MiniLM-L6-v2.onnx" Link="MlAssets\all-MiniLM-L6-v2.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\MlAssets\vocab.txt" Link="MlAssets\vocab.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
