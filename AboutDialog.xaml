<Window x:Class="RadioPlayer.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Aurora Radio" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Icon="Assets/app.ico"
        FontFamily="Segoe UI" Background="#FF161B24">

    <StackPanel Margin="24" Width="340">
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/app-256.png" Width="48" Height="48" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Aurora Radio" FontSize="20" FontWeight="SemiBold"
                           Foreground="#FFFFFFFF"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#FF9FB0C4"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="#FFD2D8E0" TextWrapping="Wrap"
                   Text="A lightweight player for internet radio streams (Icecast/Shoutcast), with now-playing info, Windows media-control integration, and taskbar controls."/>

        <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="#FFD2D8E0" TextWrapping="Wrap"
                   Text="AI-assisted search finds real, playable stations from a plain-language prompt — translating it into a directory search and ranking the results. Optional and online-only; the player works fully without it."/>

        <TextBlock Margin="0,14,0,0" FontSize="11" Foreground="#FF8C97A6" TextWrapping="Wrap"
                   Text="Audio engine: BASS (un4seen) — free for non-commercial use. Licensed under the PolyForm Noncommercial License 1.0.0."/>

        <Button Content="OK" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="84" Height="30" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
