<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0 to match installed toolchain; Windows SDK version required for WinRT/SMTC types -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- PoC tools and the test project live under tools/ and tests/ (separate projects). Keep
         their sources/artifacts out of this project's default **/*.cs and Content/Page globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;tests\**</DefaultItemExcludes>
    <!-- App identity / versioning. Bump Version (SemVer MAJOR.MINOR.PATCH) per release;
         the SDK flows it into the assembly's File/Informational version automatically. -->
    <Version>1.10.0</Version>
    <!-- The UI is English only, so WPF's satellite resource DLLs for 14 other languages are dead
         weight — roughly 8 MB across the publish, in an installer that already downloads 86 MB. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>crystal-radio</AssemblyName>
    <!-- Keep namespace RadioPlayer so no C# files need touching (shallow rename). -->
    <RootNamespace>RadioPlayer</RootNamespace>
    <Product>Crystal Radio</Product>
    <Authors>Hans Seebacher</Authors>
    <Description>Crystal Radio — a lightweight internet radio player for Windows.</Description>

    <!-- Must match the native BASS DLLs -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- EXE / Win32 icon -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-monitor v2 DPI awareness (crisp text on hi-DPI). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- MusicDetector/Fft are internal (they're an implementation detail of the QC backstop, not
       app API) but they carry the fitted weights and the edge-trim logic, which is exactly the
       part worth testing — especially while the corpus is being extended to genres it currently
       misreads. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RadioPlayer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Aac" Version="4.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Pinned to override the 2.1.11 that Microsoft.Data.Sqlite 10.0.9 pulls in transitively.
         2.1.11 bundles SQLite 3.49.1, which is exposed to CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, high,
         memory corruption fixed in SQLite 3.50.2). 2.1.12 brings SQLite 3.53.3.

         Verified by asking the native library rather than trusting version numbers: the advisory's
         affected range is "<= 2.1.11", so a bump silences NU1903 by definition — but what actually
         matters is sqlite_version(), measured at 3.49.1 before and 3.53.3 after. A patch bump inside
         the same 2.x line MDS was built against; the 3.0.x major is a bigger jump for SQLite 3.53.4,
         which buys nothing here. Drop this pin once Microsoft.Data.Sqlite ships 2.1.12+ itself. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.3" />
    <!-- ProtectedData (DPAPI) ships with the net10.0-windows desktop framework — no package. -->
  </ItemGroup>

  <!-- Window background artwork + app icon, compiled into the assembly as WPF resources. -->
  <ItemGroup>
    <Resource Include="Assets\player-bg.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
    <!-- Bundled UI font: Hanken Grotesk (SIL OFL) — the weights the UI uses. -->
    <Resource Include="Fonts\static\HankenGrotesk-Light.ttf" />
    <Resource Include="Fonts\static\HankenGrotesk-Regular.ttf" />
    <Resource Include="Fonts\static\HankenGrotesk-Medium.ttf" />
    <Resource Include="Fonts\static\HankenGrotesk-SemiBold.ttf" />
  </ItemGroup>

  <!-- Local embedding model (all-MiniLM-L6-v2) + BERT vocab, copied to the output dir.
       The .onnx is large (~90 MB) and git-ignored; see MlAssets/README for how to fetch it. -->
  <ItemGroup>
    <Content Include="MlAssets\all-MiniLM-L6-v2.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MlAssets\vocab.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Native BASS DLLs (x64) copied next to the executable -->
  <ItemGroup>
    <Content Include="native\x64\bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bass.dll</Link>
    </Content>
    <Content Include="native\x64\bass_aac.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bass_aac.dll</Link>
    </Content>
  </ItemGroup>

</Project>
