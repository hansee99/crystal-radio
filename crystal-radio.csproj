<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0 to match installed toolchain; Windows SDK version required for WinRT/SMTC types -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- PoC tools and the test project live under tools/ and tests/ (separate projects). Keep
         their sources/artifacts out of this project's default **/*.cs and Content/Page globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;tests\**;src\**</DefaultItemExcludes>
    <!-- App identity / versioning. Bump Version (SemVer MAJOR.MINOR.PATCH) per release;
         the SDK flows it into the assembly's File/Informational version automatically.
         Projects under src/ read it from here too (src/Directory.Build.props). -->
    <Version>1.10.0</Version>
    <!-- The UI is English only, so WPF's satellite resource DLLs for 14 other languages are dead
         weight — roughly 8 MB across the publish, in an installer that already downloads 86 MB. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>crystal-radio</AssemblyName>
    <!-- Keep namespace RadioPlayer so no C# files need touching (shallow rename). -->
    <RootNamespace>RadioPlayer</RootNamespace>
    <Product>Crystal Radio</Product>
    <Authors>Hans Seebacher</Authors>
    <Description>Crystal Radio — a lightweight internet radio player for Windows.</Description>

    <!-- Must match the native BASS DLLs -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- EXE / Win32 icon -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-monitor v2 DPI awareness (crisp text on hi-DPI). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- The tests reach internals here too, not only in RadioPlayer.Core: view helpers
       (ListCentering, OptionsDialog) and the Windows-only services (WindowsNotificationService). -->
  <ItemGroup>
    <InternalsVisibleTo Include="RadioPlayer.Tests" />
  </ItemGroup>

  <!-- Everything platform-neutral (models, services, engines, view model, threading) lives in
       RadioPlayer.Core; its packages flow here through this reference. -->
  <ItemGroup>
    <ProjectReference Include="src\RadioPlayer.Core\RadioPlayer.Core.csproj" />
    <!-- ProtectedData (DPAPI) ships with the net10.0-windows desktop framework — no package. -->
  </ItemGroup>

  <!-- Window background artwork + app icon, compiled into the assembly as WPF resources. -->
  <ItemGroup>
    <Resource Include="Assets\player-bg.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
    <!-- Bundled UI font: Hanken Grotesk (SIL OFL) — the weights the UI uses. -->
    <Resource Include="Fonts\static\HankenGrotesk-Light.ttf" />
    <Resource Include="Fonts\static\HankenGrotesk-Regular.ttf" />
    <Resource Include="Fonts\static\HankenGrotesk-Medium.ttf" />
    <Resource Include="Fonts\static\HankenGrotesk-SemiBold.ttf" />
  </ItemGroup>

  <!-- Local embedding model (all-MiniLM-L6-v2) + BERT vocab, copied to the output dir.
       The .onnx is large (~90 MB) and git-ignored; see MlAssets/README for how to fetch it. -->
  <ItemGroup>
    <Content Include="MlAssets\all-MiniLM-L6-v2.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MlAssets\vocab.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Native BASS DLLs (x64) copied next to the executable -->
  <ItemGroup>
    <Content Include="native\x64\bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bass.dll</Link>
    </Content>
    <Content Include="native\x64\bass_aac.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bass_aac.dll</Link>
    </Content>
  </ItemGroup>

</Project>
