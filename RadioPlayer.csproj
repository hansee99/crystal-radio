<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0 to match installed toolchain; Windows SDK version required for WinRT/SMTC types -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- App identity / versioning. Bump Version (SemVer MAJOR.MINOR.PATCH) per release;
         the SDK flows it into the assembly's File/Informational version automatically. -->
    <Version>1.0.0</Version>
    <Product>Radio Player</Product>
    <Authors>Hans Seebacher</Authors>
    <Description>A lightweight internet radio player for Windows.</Description>

    <!-- Must match the native BASS DLLs -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- EXE / Win32 icon -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Aac" Version="4.0.2" />
  </ItemGroup>

  <!-- Window background artwork + app icon, compiled into the assembly as WPF resources. -->
  <ItemGroup>
    <Resource Include="Assets\player-bg.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <!-- Native BASS DLLs (x64) copied next to the executable -->
  <ItemGroup>
    <Content Include="native\x64\bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bass.dll</Link>
    </Content>
    <Content Include="native\x64\bass_aac.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bass_aac.dll</Link>
    </Content>
  </ItemGroup>

</Project>
