@page "/history"
@inherits PlayerView<History.Snapshot>

<PageTitle>History · Crystal Radio</PageTitle>

<section class="card">
    <h1>History</h1>
    @if (Snap is not { } s)
    {
        <p class="muted">Loading…</p>
    }
    else if (s.Rows.Count == 0)
    {
        <p class="muted">Songs you hear on your stations will appear here.</p>
    }
    else
    {
        <ul class="list">
            @foreach (var r in s.Rows)
            {
                <li class="row @(r.IsCurrent ? "current" : "")">
                    <div class="row-main">
                        <span class="row-title">@r.Title</span>
                        <span class="row-sub">@r.Subtitle</span>
                    </div>
                    @if (r.IsSaved)
                    {
                        <span class="icon-state saved" title="Saved to your library" role="img" aria-label="Saved"><Icon Name="check-circle" /></span>
                    }
                    else if (r.MarkedForSave)
                    {
                        <span class="icon-state marked" title="Saves when the song ends" role="img" aria-label="Saves when the song ends"><Icon Name="add-circle" /></span>
                    }
                    else if (r.CanSave)
                    {
                        var saveLabel = r.IsCurrent ? "Save when it ends" : "Save to your library";
                        <button class="icon-btn" title="@saveLabel" aria-label="@saveLabel" @onclick="@(() => Save(r.Key))"><Icon Name="add-circle" /></button>
                    }
                    else if (r.IsCurrent)
                    {
                        <span class="badge">Now</span>
                    }
                </li>
            }
        </ul>
        @if (s.Total > s.Rows.Count)
        {
            <p class="muted">Showing the latest @s.Rows.Count of @s.Total.</p>
        }
    }
</section>

@code {
    /// <summary>History can run to thousands of rows; a phone doesn't need them all at once.</summary>
    private const int MaxRows = 200;

    public sealed record Row(string Key, string Title, string Subtitle, bool IsCurrent, bool IsSaved,
        bool MarkedForSave, bool CanSave);
    public sealed record Snapshot(IReadOnlyList<Row> Rows, int Total);

    // Rows are addressed by key, not index: a new song is inserted at the top, which would shift
    // every index between rendering the list and the tap.
    private static string KeyOf(SongHistoryEntry e) => $"{e.PlayedAt.Ticks}|{e.Title}";

    // Newest first, as the view model keeps it. Subtitle is the desktop's own "artist · station · time".
    protected override Snapshot Read(AppServices a) => new(
        a.ViewModel.History.Take(MaxRows)
            .Select(e => new Row(KeyOf(e), e.Title, e.Subtitle, e.IsCurrent, e.IsSaved,
                e.MarkedForSave, e.CanSaveOrMark)).ToList(),
        a.ViewModel.History.Count);

    // SaveSongCommand saves a finished song into the library folder, or marks the playing one to be
    // saved when it ends — the desktop's row button, same command.
    private Task Save(string key) => Do(a =>
    {
        var vm = a.ViewModel;
        var entry = vm.History.FirstOrDefault(e => KeyOf(e) == key);
        if (entry is not null && vm.SaveSongCommand.CanExecute(entry))
            vm.SaveSongCommand.Execute(entry);
    });
}
