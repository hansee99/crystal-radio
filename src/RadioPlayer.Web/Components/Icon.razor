@*
    The desktop's icons (Views/Theme.xaml geometries, copied verbatim) as inline SVG, so both front
    ends draw the same glyphs — and no emoji, which the design rules out. 24×24 box like the
    originals; filled glyphs for transport and the sparkle, 1.7 px round-capped strokes for the rest.
    Decorative by default (aria-hidden): the button that holds it carries the accessible name.
*@
@if (Paths.TryGetValue(Name, out var icon))
{
    <svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true" focusable="false">
        @if (icon.Filled)
        {
            <path d="@icon.D" fill="currentColor" />
        }
        else
        {
            <path d="@icon.D" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        }
    </svg>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }

    private sealed record Glyph(string D, bool Filled);

    // Rectangles from the XAML (RectangleGeometry with radius) are written as rounded-rect paths.
    private static readonly Dictionary<string, Glyph> Paths = new()
    {
        ["play"]  = new("M8 5 L19 12 L8 19 Z", true),
        ["pause"] = new("M9 5.5 h1 a1 1 0 0 1 1 1 v11 a1 1 0 0 1 -1 1 h-1 a1 1 0 0 1 -1 -1 v-11 a1 1 0 0 1 1 -1 Z " +
                        "M14 5.5 h1 a1 1 0 0 1 1 1 v11 a1 1 0 0 1 -1 1 h-1 a1 1 0 0 1 -1 -1 v-11 a1 1 0 0 1 1 -1 Z", true),
        ["stop"]  = new("M9.1 6.5 h5.8 a2.6 2.6 0 0 1 2.6 2.6 v5.8 a2.6 2.6 0 0 1 -2.6 2.6 h-5.8 a2.6 2.6 0 0 1 -2.6 -2.6 v-5.8 a2.6 2.6 0 0 1 2.6 -2.6 Z", true),
        ["next"]  = new("M6.5 5.5 L15 12 L6.5 18.5 Z " +
                        "M16.7 5.5 h0.4 a1 1 0 0 1 1 1 v11 a1 1 0 0 1 -1 1 h-0.4 a1 1 0 0 1 -1 -1 v-11 a1 1 0 0 1 1 -1 Z", true),
        ["prev"]  = new("M17.5 5.5 L9 12 L17.5 18.5 Z " +
                        "M6.9 5.5 h0.4 a1 1 0 0 1 1 1 v11 a1 1 0 0 1 -1 1 h-0.4 a1 1 0 0 1 -1 -1 v-11 a1 1 0 0 1 1 -1 Z", true),
        ["sparkle"] = new("M10 2.2 Q11.3 8.7 17.8 10 Q11.3 11.3 10 17.8 Q8.7 11.3 2.2 10 Q8.7 8.7 10 2.2 Z " +
                          "M18.4 14.6 Q19 17.4 21.8 18 Q19 18.6 18.4 21.4 Q17.8 18.6 15 18 Q17.8 17.4 18.4 14.6 Z", true),
        ["volume"] = new("M4 9.5 L8 9.5 L13 5.5 L13 18.5 L8 14.5 L4 14.5 Z", true),

        ["radio"]  = new("M8.6 8.6a5 5 0 0 0 0 6.8 M15.4 8.6a5 5 0 0 1 0 6.8 M6.1 6.1a9 9 0 0 0 0 11.8 M17.9 6.1a9 9 0 0 1 0 11.8", false),
        ["plus"]   = new("M12 6.5 L12 17.5 M6.5 12 L17.5 12", false),
        ["check"]  = new("M5 12.5 L10 17.5 L19 7.5", false),
        ["search"] = new("M11 4.4 A6.6 6.6 0 1 0 11 17.6 A6.6 6.6 0 1 0 11 4.4 M16 16 L20.5 20.5", false),
        ["close"]  = new("M7 7 L17 17 M17 7 L7 17", false),
        ["add-circle"]   = new("M12 3.6 A8.4 8.4 0 1 0 12 20.4 A8.4 8.4 0 1 0 12 3.6 M12 8.2 V15.8 M8.2 12 H15.8", false),
        ["check-circle"] = new("M12 3.6 A8.4 8.4 0 1 0 12 20.4 A8.4 8.4 0 1 0 12 3.6 M8.1 12.2 L10.9 15.1 L15.9 9.6", false),
        ["delete"] = new("M5.5 7 H18.5 M9.5 7 V5 H14.5 V7 M7 7 L8 19.5 H16 L17 7 M10.5 10 V16 M13.5 10 V16", false),
    };
}
